rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // FUNCIONES HELPER
    // ============================================================

    function isAuth() {
      return request.auth != null;
    }

    // P9: lectura de datos con PII (p.ej. live_matches) exige usuario
    // REGISTRADO Y AUTORIZADO, no solo autenticado. Verifica que exista
    // users/{uid} con isAuthorized == true. Asi un usuario con cuenta
    // creada pero pendiente de aprobacion tampoco puede leer la PII.
    function isRegisteredUser() {
      return request.auth != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAuthorized', false) == true;
    }

    // FIX: isSuperAdminEmail() verifica contra cronos_config/superadmins
    // en lugar de hardcodear un email. Esto evita:
    //   1. Typos en el email hardcodeado (jarg7435 vs jarc7435)
    //   2. Que cambios de email del SA requieran redeploy de reglas
    //   3. Que múltiples SAs no sean reconocidos
    function isSuperAdminEmail() {
      return isAuth() &&
             ('email' in request.auth.token) &&
             exists(/databases/$(database)/documents/cronos_config/superadmins) &&
             ('emails' in get(/databases/$(database)/documents/cronos_config/superadmins).data) &&
             request.auth.token.email in
               get(/databases/$(database)/documents/cronos_config/superadmins).data.emails;
    }

    function isSuperAdmin() {
      return isAuth() &&
             ((('role' in request.auth.token) && request.auth.token.role == 'superadmin') ||
              isSuperAdminEmail());
    }

    function isClubAdmin(clubId) {
      return isAuth() &&
             ('role' in request.auth.token) && request.auth.token.role == 'club_admin' &&
             ('clubId' in request.auth.token) && request.auth.token.clubId == clubId;
    }

    function isIndividualAdmin(clubId) {
      return isAuth() &&
             ('role' in request.auth.token) &&
             (request.auth.token.role == 'individual_admin' ||
              request.auth.token.role == 'individual' ||
              request.auth.token.role == 'admin_individual') &&
             ('clubId' in request.auth.token) && request.auth.token.clubId == clubId;
    }

    // FIX (dismiss informes de staff): un usuario con rol director/coordinador
    // según su DOCUMENTO users/{uid} (no el token, que puede no llevar el claim).
    // Se usa para permitir que el staff oculte informes de SU panel añadiendo su
    // UID a dismissedByStaff, incluso cuando el documento del informe NO incluye
    // staffUids ni un clubId que case con users/{uid}.clubId (docs legacy o
    // variantes _coach_pN / _pN sin esos campos). No amplía la superficie: la
    // regla que la invoca sigue restringida a modificar SOLO dismissedByStaff.
    // v435 · CUERPO TECNICO, por rol explicito. A diferencia de
    // isStaffRoleByDoc(), que ademas da por staff a cualquiera con `allRoles`
    // no vacio —un padre incluido—, esta exige el rol concreto. Se usa para
    // decidir quien gestiona los informes COLECTIVOS: el criterio del autor
    // dice Director Deportivo, Coordinador y Entrenador, y un padre NO debe
    // poder borrar el informe colectivo de un equipo.
    function isTechStaffByDoc() {
      return isAuth()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid))
                  .data.get('role', '') in ['director', 'coordinator', 'coach',
                                            'club_admin', 'individual_admin'];
    }

    function isStaffRoleByDoc() {
      return isAuth()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && (
                  get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['director', 'coordinator']
                  || (
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAuthorized', false) == true
                       && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('allRoles', []) is list
                       && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('allRoles', []).size() > 0
                     )
                );
    }

    function sameClub(clubId) {
      return isClubAdmin(clubId) || isIndividualAdmin(clubId);
    }

    // ============================================================
    // NOTA (Opcion B - ventana de gracia NO renovable):
    // ------------------------------------------------------------
    // transitionalRead() se RESTAURA (ver definicion mas abajo) pero
    // medida desde users/{uid}.createdAt (creacion de la cuenta), NO desde
    // auth_time. Deja de ser renovable con logout+login. Se mantiene como
    // rama ADICIONAL (OR) junto a los predicados no renovables ya
    // existentes (userDocClubId / sameClubAsDoc / propiedad por email-uid),
    // que siguen cubriendo a los usuarios ya aprobados.
    // ============================================================

    // ============================================================
    // transitionalRead() / hasClaims()  -  ventana de gracia NO renovable
    // ------------------------------------------------------------
    // hasClaims(): comprueba la PRESENCIA de los custom claims 'role' y
    // 'clubId' con el operador `in` (acceder a una clave AUSENTE del token NO
    // devuelve null en Firestore Rules: lanza un error de evaluacion que haria
    // fallar toda la condicion). transitionalRead() solo aplica a usuarios SIN
    // claims, asi que esta comprobacion null-safe es imprescindible.
    //
    // transitionalRead(clubId): concede una BREVE ventana de gracia (5 min) a
    // un usuario recien registrado y aun SIN custom claims, mientras el trigger
    // autoSetClaimsOnApproval / syncRootClubId (Admin SDK) propaga sus claims.
    //
    // CLAVE DE SEGURIDAD - NO RENOVABLE:
    //   La ventana se mide desde users/{uid}.createdAt (instante de CREACION de
    //   la cuenta, campo INMUTABLE escrito UNA sola vez con serverTimestamp),
    //   NO desde auth_time (instante de AUTENTICACION). Con auth_time el acceso
    //   era RENOVABLE indefinidamente: bastaba repetir logout+login para
    //   refrescar auth_time y prolongar la ventana sin limite (backdoor). Con
    //   createdAt la ventana es FIJA por cuenta: caduca 5 min despues del alta y
    //   NO se puede prolongar con logout+login ni de ninguna otra forma.
    //   Se exige `createdAt is timestamp` (fail-closed): documentos sin ese
    //   campo, o con un createdAt string legacy (ISO), NO obtienen acceso.
    //
    // CLAVE DE SEGURIDAD - PROPIEDAD DE CLUB (AUDITORIA 2026-07-22):
    //   Ademas de la ventana temporal, se exige que users/{uid}.clubId (el club
    //   con el que el usuario se registro, escrito por el propio alta) coincida
    //   con el clubId del documento al que se pide acceso. Sin este check, la
    //   version anterior de transitionalRead() solo exigia clubId != null en el
    //   documento objetivo: CUALQUIER cuenta recien creada (de cualquier club, o
    //   de ninguno) podia leer/escribir documentos de CUALQUIER OTRO club durante
    //   la ventana de 5 min, sin relacion alguna con su propio club. Con este
    //   check, la ventana de gracia solo cubre el club al que el usuario dice
    //   pertenecer (mismo campo que usa userDocClubId para usuarios ya
    //   aprobados) - no amplia el acceso mas alla de lo que tendria en cuanto
    //   sus claims se propaguen.
    //
    //   Nota: los get() a users/{uid} se resuelven a UNA sola lectura facturada
    //   (Firestore memoiza el acceso al mismo documento dentro de una misma
    //   evaluacion de reglas), por lo que no hace falta cachear con let.
    // ============================================================
    function hasClaims() {
      return isAuth() &&
             ('role' in request.auth.token) &&
             ('clubId' in request.auth.token);
    }

    function transitionalRead(clubId) {
      return isAuth() && !hasClaims() && clubId != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('clubId', '') == clubId
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('createdAt', null) is timestamp
             && (request.time - get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('createdAt', request.time)) < duration.value(5, 'm');
    }

    function isIndividualEntity(resourceData) {
      return resourceData.type == 'individual';
    }

    // ============================================================
    // DIRECTOR DEPORTIVO DE **ESTE** CLUB  (pestanya "Config.", 2026-07-29)
    //
    // Se resuelve por el DOCUMENTO users/{uid} y no por el token, igual que
    // isStaffRoleByDoc y transitionalRead: el claim de rol puede no estar
    // presente. Los campos RAIZ role/clubId son los correctos aqui — la app los
    // mantiene a proposito para que las reglas puedan verificarlos (ver el FIX
    // v179 de openStaffDashboard, que migra clubId a la raiz, y la Cloud
    // Function syncRootClubId).
    //
    // Atar el clubId del director al {clubId} del documento es lo que impide la
    // escalada cross-club que motivo la retirada de la rama de v188.
    // ============================================================
    function isClubDirectorOf(clubId) {
      return isAuth() && clubId != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'director'
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('clubId', '') == clubId
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAuthorized', false) == true
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'active';
    }

    function isClubCoordinatorOf(clubId) {
      return isAuth() && clubId != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'coordinator'
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('clubId', '') == clubId
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAuthorized', false) == true
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'active';
    }

    // Los TRES unicos campos que escribe la pestanya "Config." del Director
    // (js/coach/reports/director-config.js): categoryConfigs, timerThresholds y
    // features.sendIndividualReports.
    //
    // ⚠️ EL SEGUNDO diff NO ES REDUNDANTE: `features` es un MAPA que contiene
    // ademas `live_view`, que gestiona el club_admin desde su panel. Permitir
    // 'features' entero dejaria al director activarse esa funcion. Por eso se
    // acota tambien DENTRO del mapa, a la unica clave que la pestanya toca.
    // Quedan fuera, por tanto: directorUids, coordinatorUids, adminUid, plan,
    // status, expiresAt y features.live_view.
    function isClubConfigOnlyUpdate() {
      // v594 · `inviteTemplate` — la plantilla de invitacion de Secretaria.
      // El autor pidio que el Director pueda redactar el mensaje a su gusto
      // y GUARDARLO para las proximas invitaciones. Va en el CLUB y no en la
      // persona a proposito: asi sobrevive a un cambio de director.
      // Por que no reabre nada: esta rama ya exige isClubDirectorOf(clubId)
      // -o sea, el director de ESTE club-, y `hasOnly` sigue dejando fuera
      // directorUids, coordinatorUids, adminUid, plan, status y expiresAt.
      // Es un texto: no concede ningun privilegio.
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['categoryConfigs', 'timerThresholds', 'features', 'inviteTemplate'])
             && request.resource.data.get('features', {})
                  .diff(resource.data.get('features', {})).affectedKeys()
                  .hasOnly(['sendIndividualReports']);
    }

    // ============================================================
    // 2026-08-13 · QUIÉN PUEDE DESTRUIR UN INFORME COLECTIVO
    // ------------------------------------------------------------
    // Regla del autor, en sus palabras: la potestad depende "única y
    // exclusivamente de entrar y tener activo el rol de Director Deportivo o
    // Administrador del Club", y "aunque una misma persona posea varios
    // cargos o el correo coincida". Si a mitad de temporada esa persona pasa a
    // ser sólo coordinador o entrenador, PIERDE la potestad automáticamente.
    //
    // 🔑🔑 POR ROL, NUNCA POR IDENTIDAD. Aquí NO se usa isClubAdminOf(), que
    // concede por `clubs/{id}.adminUid` o —peor— por COINCIDENCIA DE CORREO
    // (`adminEmail == token.email`). Ese camino sobrevive a un cambio de
    // cargo: la persona seguiría borrando informes después de dejar de ser
    // director, que es justo lo que hay que impedir.
    //
    // 🔑 SE MIRA EL ROL EN DOS SITIOS Y LOS DOS SIGUEN AL CARGO:
    //   · el CLAIM `role` del token, que la Cloud Function autoSetClaims
    //     reescribe cuando cambia users/{uid}.role — así que al degradar a
    //     coordinador el token deja de valer solo;
    //   · y el propio users/{uid}, como respaldo mientras el claim se
    //     propaga, con las mismas exigencias de pertenencia y estado.
    // Ninguna de las dos vías mira quién es la persona.
    //
    // ⚠️ SE EXIGE isAuthorized Y status ACTIVO: un director dado de baja o
    // pendiente no destruye datos. Verificado contra producción que todas las
    // cuentas reales llevan status 'active', así que no cierra la puerta a
    // nadie legítimo.
    //
    // ⚠️ LÍMITE HONESTO: las reglas NO pueden ver el rol con el que se ha
    // ENTRADO en la sesión —`_activeRole` es del cliente y no viaja—. Esta
    // función exige TENER el cargo; que además se esté ACTUANDO con él lo
    // impone la interfaz (window._sdPuedePurgar). Las dos capas juntas dan la
    // regla completa, y la de servidor es la que no se puede saltar.
    function puedePurgarInformes(clubId) {
      return isAuth() && clubId != null && (
        (
          ('role' in request.auth.token)
          && (request.auth.token.role == 'director' || request.auth.token.role == 'club_admin')
          && ('clubId' in request.auth.token) && request.auth.token.clubId == clubId
        ) || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'director'
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'club_admin')
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('clubId', '') == clubId
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAuthorized', false) == true
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', '') == 'active'
        )
      );
    }

    // Mismo club por campo del documento
    function sameClubAsDoc(docClubId) {
      return isAuth() && ('clubId' in request.auth.token) && request.auth.token.clubId == docClubId;
    }

    // FIX (club_admin sin claim): permite que el administrador real de un club
    // —según el documento del club (clubs/{clubId}.adminUid)— lea los docs de
    // 'users' de su club aunque su TOKEN aún no tenga el custom claim 'clubId'
    // (los claims se asignan vía setCustomClaims; este fallback cubre a los
    // club_admin ya aprobados antes de que se asignaran claims). Solo concede
    // acceso si el uid coincide con el adminUid registrado en el club, así que
    // no amplía la superficie de seguridad más allá del verdadero admin.
    function isClubAdminOf(docClubId) {
      return isAuth() && docClubId != null
             && exists(/databases/$(database)/documents/clubs/$(docClubId))
             && (
                  get(/databases/$(database)/documents/clubs/$(docClubId)).data.get('adminUid', '') == request.auth.uid
                  || (('email' in request.auth.token) && get(/databases/$(database)/documents/clubs/$(docClubId)).data.get('adminEmail', '') == request.auth.token.email)
                );
    }

    // ============================================================
    // v474 · DECISION DE PERTENENCIA (aprobar / rechazar / bloquear)
    // ------------------------------------------------------------
    // isAdminOfClub(): el ADMINISTRADOR de ese club o de esa entidad
    // individual. Se resuelve por CLAIM (isClubAdmin / isIndividualAdmin) y,
    // como respaldo, por clubs/{clubId}.adminUid|adminEmail (isClubAdminOf),
    // que cubre al administrador cuyo token aun no tiene los claims.
    //
    // ⚠️ NO se usa sameClubAsDoc() AQUI, aunque sea el predicado habitual del
    // fichero: solo mira request.auth.token.clubId, y ESE claim lo lleva
    // CUALQUIER miembro autorizado del club —un entrenador o un padre
    // incluidos, porque autoSetClaimsOnApproval se lo pone a todos—. Usarlo
    // habria dado a toda la plantilla el poder de aceptar y rechazar altas.
    // ============================================================
    function isAdminOfClub(clubId) {
      return isAuth() && clubId != null && (
               isClubAdmin(clubId) ||
               isIndividualAdmin(clubId) ||
               isClubAdminOf(clubId) ||
               isClubDirectorOf(clubId) ||
               isClubCoordinatorOf(clubId)
             );
    }

    // Los UNICOS campos que esa decision puede tocar en users/{uid}. Son los
    // que escriben caApproveRequest / caConfirmClubAccess / caRejectRequest /
    // caSetUserStatus (js/admin/club/panel.js).
    //
    // ⚠️ QUEDAN FUERA A PROPOSITO 'role', 'clubId' y 'clubName': sin ellos el
    // administrador no puede ascender a nadie (ni a si mismo) a otro rol, ni
    // arrastrar la cuenta de un usuario al club de otro. La rama solo aplica
    // ademas a documentos cuyo clubId YA es el suyo, asi que el alcance es
    // exactamente "los usuarios de mi club, y solo su estado de acceso".
    function isMembershipDecision() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'isAuthorized', 'status', 'allRoles',
        'authorizedAt', 'authorizedBy',
        'rejectedAt', 'rejectedBy',
        'blockedAt', 'blockedBy',
        'category', 'categoryLabel', 'subcategory',
        'updatedAt'
      ])
      && clubNoActivaSinSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════
    //  v546 · EL ADMINISTRADOR DE CLUB NO PUEDE ACTIVAR POR SU CUENTA
    //
    //  Reportado por el autor el 2026-08-16: *"la aplicacion mete al usuario
    //  en el plantel activo saltandose por completo la aprobacion obligatoria
    //  del SuperAdmin"*. Y era cierto por esta via: `isMembershipDecision()`
    //  aceptaba `isAuthorized` y `status` sin mirar su VALOR, asi que el boton
    //  "Aceptar" del panel de club escribia `isAuthorized:true, status:'active'`
    //  en el documento de otro usuario y lo dejaba dentro. El SuperAdmin no
    //  llegaba a verlo.
    //
    //  ⚠️ NO SE PUEDE CERRAR A LO BRUTO quitando los dos campos de la lista:
    //  el club tiene que seguir pudiendo RECHAZAR (status:'rejected'),
    //  BLOQUEAR (status:'blocked') y REVOCAR una casilla (allRoles), que son
    //  suyas y no activan a nadie. Por eso se fijan los VALORES en vez de
    //  prohibir los campos — el mismo patron que ya usa `allow create` mas
    //  abajo, y por la misma razon.
    //
    //  🔑 LA UNICA EXCEPCION es la CONFIRMACION posterior: cuando el
    //  SuperAdmin ya ha aprobado, deja `approvedBySA:true` en el documento y
    //  el club remata el alta (consume su plaza). Eso NO se salta a nadie.
    //  Se mira `resource` —el documento EXISTENTE—, nunca `request.resource`:
    //  si se mirase el entrante, bastaria con enviar `approvedBySA:true` en la
    //  misma escritura para saltarselo. Y ademas `approvedBySA` no esta en la
    //  lista de `hasOnly()` de arriba, asi que el club tampoco puede
    //  escribirlo: doble candado. Solo lo escribe el SuperAdmin
    //  (js/admin/superadmin/clubs-tab.js y create-direct.js).
    // ══════════════════════════════════════════════════════════════════
    //  ⚠️⚠️ SE MIRA LA **TRANSICION**, NO EL VALOR FINAL. La primera version
    //  de esta funcion exigia `isAuthorized == false` en el documento
    //  entrante, y eso rompia al club para lo que SI es suyo: en un update,
    //  `request.resource.data` trae el documento RESULTANTE COMPLETO, asi que
    //  al cambiarle la categoria a un entrenador YA ACTIVO llegaba
    //  `isAuthorized:true` sin que nadie estuviera activando nada, y se
    //  denegaba. Lo detecto el banco de pruebas contra el motor real ANTES de
    //  desplegar. Lo que hay que prohibir es el SALTO de "no activo" a
    //  "activo", no que el campo valga true.
    function activaAlUsuario() {
      return (request.resource.data.get('isAuthorized', false) == true
              && resource.data.get('isAuthorized', false) == false)
             || (request.resource.data.get('status', '') == 'active'
                 && resource.data.get('status', '') != 'active');
    }
    function clubNoActivaSinSuperAdmin() {
      return !activaAlUsuario()
             || resource.data.get('approvedBySA', false) == true;
    }

    // El usuario es el propietario del enlace padre→jugador
    function isLinkOwner() {
      return isAuth() && request.auth.uid == resource.data.get('parentUid', null);
    }

    // FIX (entrenador sin custom claim): el token del entrenador (rol 'user')
    // suele NO llevar el claim 'clubId' (los claims solo se asignaban al
    // club_admin). Las reglas que dependen de request.auth.token.clubId
    // (sameClubAsDoc/sameClub) le negaban escribir/leer informes, vínculos y
    // mensajes de su propio club. Este helper verifica la pertenencia al club
    // leyendo el DOCUMENTO de Firestore del propio usuario (users/{uid}.clubId),
    // no el token. No amplía la superficie: solo concede acceso a documentos del
    // mismo club en el que el usuario está realmente registrado y autorizado.
    // ⚠️ SEC-C1 (2026-07-29): este predicado exige ademas que la cuenta este
    // AUTORIZADA. Antes bastaba con que users/{uid}.clubId coincidiera, y como
    // el `create` de users/{userId} no restringia campos, cualquiera podia
    // ponerse un clubId AJENO al registrarse y obtener escritura cross-club por
    // esta via — sin necesidad siquiera de autoconcederse isAuthorized.
    // Verificado ejecutandolo contra la Rules API (caso A4 del test).
    //
    // Es el predicado de pertenencia mas usado del archivo (28 sitios), asi que
    // el cambio tiene radio amplio A PROPOSITO: cierra la escalada en todos a la
    // vez. Solo deja fuera a cuentas NO autorizadas, que no deberian poder
    // escribir nada; los flujos legitimos (coach aprobado leyendo/escribiendo en
    // su club) se comprobaron uno a uno antes de aplicarlo.
    function userDocClubId(docClubId) {
      return isAuth() && docClubId != null
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('clubId', '') == docClubId
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAuthorized', false) == true;
    }

    // El usuario tiene acceso al club de este enlace
    function isLinkClubMember() {
      return isAuth() && (
        sameClub(resource.data.get('clubId', null)) ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        userDocClubId(resource.data.get('clubId', null))
      );
    }

    function isValidPlayerData(data) {
      return data.keys().hasOnly([
        'pseudonym', 'number', 'position', 'isStarting',
        'teamId', 'clubId', 'matchId', 'updatedAt', 'isActive',
        'name', 'surname', 'createdAt'
      ]);
    }

    // ============================================================
    // COLECCIÓN: users
    // SEC-011: Prevent self-role escalation
    // ============================================================
    match /users/{userId} {
      // ══════════════════════════════════════════════════════════════════
      //  🟠 SEC-A1 (auditoria 2026-08-26) · EL CENSO DEJA DE SER PUBLICO
      //
      //  Antes: `allow read: if isAuth()`. CUALQUIER usuario con una cuenta
      //  leia el documento de CUALQUIER persona de CUALQUIER club: correo,
      //  nombre, rol, club y el `allRoles` entero. Contradice de frente lo que
      //  promete privacy.html — "cada usuario solo accede a los datos de su
      //  club"— y era lo que convertia una cuenta huerfana en un lector de
      //  todo el censo.
      //
      //  🔑 LAS CINCO RAMAS SON LAS CINCO CONSULTAS REALES DE LA APP, medidas
      //  una por una antes de escribir esto. En Firestore una consulta se
      //  DENIEGA ENTERA si la regla no puede demostrar que todo lo que
      //  devolveria es legible, asi que cada rama tiene que casar con un
      //  `where` de verdad o la pantalla se queda muda:
      //
      //   1. UNO MISMO — `getDoc(users/{miUid})`, en media aplicacion.
      //   2. EL SUPERADMIN — sus paneles consultan por `status`, `email` y
      //      `uid` sin filtro de club; isSuperAdmin() no depende del documento,
      //      asi que la consulta es demostrable.
      //   3. TUS PROPIOS DOCUMENTOS POR CORREO — el caso multi-rol: la misma
      //      persona con el mismo correo y clubId distinto (comms/panel.js:1178
      //      y reports-tab.js:182). Solo puedes leer los que llevan TU correo.
      //   4. LA GENTE DE TU ENTIDAD — las consultas `where('clubId','==',cid)`.
      //   5. EL SUPERADMIN COMO CONTACTO — `where('role','==','superadmin')`
      //      (comms/panel.js:1772). Un administrador de club necesita abrir
      //      canal con el soporte de la plataforma, y ese es inherentemente
      //      cross-club: ninguna rama por club puede cubrirlo. Expone su
      //      correo, que privacy.html ya declara como el contacto habilitado.
      //
      //  ⚠️ NO SE PUEDE PROBAR CON EL `:test` DE LA RULES API: ese metodo
      //  evalua operaciones sobre UN documento, no la legalidad de una
      //  CONSULTA. Esto se verifico lanzando las consultas de verdad contra
      //  produccion con el token de un usuario normal.
      // ══════════════════════════════════════════════════════════════════
      allow read: if isAuth() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (('email' in request.auth.token) &&
         resource.data.get('email', null) == request.auth.token.email) ||
        sameClub(resource.data.get('clubId', null)) ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        userDocClubId(resource.data.get('clubId', null)) ||
        // 🔑 EL ENTE INDIVIDUAL CONSULTA POR OTRO CAMPO. Su panel busca a su
        //    gente con `where('individualEntityId','==',ente)` y
        //    `where('individualOwnerId','==',ente)`, no por `clubId`
        //    (admin/individual/panel.js:339-377). Sin estas dos ramas la
        //    consulta no es demostrable y el panel del ente se queda VACIO —
        //    lo detecto un segundo barrido, no el primero.
        sameClub(resource.data.get('individualEntityId', null)) ||
        sameClubAsDoc(resource.data.get('individualEntityId', null)) ||
        userDocClubId(resource.data.get('individualEntityId', null)) ||
        sameClub(resource.data.get('individualOwnerId', null)) ||
        sameClubAsDoc(resource.data.get('individualOwnerId', null)) ||
        userDocClubId(resource.data.get('individualOwnerId', null)) ||
        resource.data.get('role', '') == 'superadmin'
      );
      // ⚠️ SEC-C1 (create) — CERRADO 2026-07-29. Antes esta regla NO restringia
      // NINGUN campo, asi que un usuario recien registrado podia crear SU PROPIO
      // documento con `isAuthorized: true` y `status: 'active'` y, con eso,
      // pasar isRegisteredUser() y userDocClubId(): leer y ESCRIBIR en los
      // partidos en vivo de OTRO club (PII de menores). No hacia falta usar la
      // app: basta el SDK con el token de una cuenta nueva, antes de que exista
      // su documento. Verificado ejecutandolo contra la Rules API, no deducido.
      //
      // CORRECCIONES_ESTADO.md daba esto por "riesgo residual BAJO" alegando que
      // isAuthorized/status "siguen prohibidos en create+update". Eso era cierto
      // solo del update: la lista de campos prohibidos (hasAny) vive abajo, en
      // `allow update`, y el create no tenia ninguna.
      //
      // POR QUE SE FIJAN LOS VALORES EN VEZ DE PROHIBIR LOS CAMPOS: prohibirlos
      // se intento antes (commit f3444df) y se REVIRTIO porque el alta de
      // usuarios individuales escribe legitimamente clubId, role y status en el
      // propio create (services/auth.js), y nulificarlos exigia rediseniar antes
      // el descubrimiento de pendientes por club_admin. Fijar los VALORES
      // permitidos deja intacto ese alta —que escribe isAuthorized:false y
      // status:'pending_individual'— y cierra la escalada igual.
      // La concesion real la sigue haciendo EXCLUSIVAMENTE el Admin SDK.
      // ══════════════════════════════════════════════════════════════════
      //  🔴🔴🔴 SEC-C1b (2026-08-25) · EL `role` TAMBIEN SE FIJA EN EL CREATE
      //
      //  Auditoria de seguridad con usuarios reales ya en produccion. SEC-C1
      //  cerro `isAuthorized` y `status` fijando sus VALORES... y dejo `role`
      //  libre. En `allow update` si esta prohibido (ver el hasAny de abajo);
      //  en el create no habia nada.
      //
      //  🔑 POR SI SOLO NO CONCEDE NADA EN LAS REGLAS —isSuperAdmin() mira el
      //  TOKEN, que solo escribe el Admin SDK—, pero la Cloud Function
      //  `setCustomClaims` decide quien es SuperAdmin leyendo ESTE campo del
      //  DOCUMENTO (functions/index.js:112, `callerData?.role`). La cadena
      //  medida, sin usar siquiera la aplicacion:
      //    1. alta con cualquier correo (el registro es publico);
      //    2. setDoc de su PROPIO doc con role:'superadmin' (esto lo permitia);
      //    3. llamada a setCustomClaims -> la funcion lee el doc, ve
      //       'superadmin' y CONCEDE EL CLAIM DE VERDAD;
      //    4. y su rama `if (role === 'superadmin')` le activa la cuenta.
      //  Con el token refrescado, isSuperAdmin() pasa a ser cierto AQUI.
      //
      //  ⚠️ ES UNA LISTA NEGRA DE DOS VALORES, NO UNA LISTA BLANCA, Y A
      //  PROPOSITO. Una lista blanca tendria que enumerar todos los roles que
      //  un alta escribe legitimamente ('user', 'parent', 'director',
      //  'coordinator', 'club_admin', 'individual', 'parent_individual',
      //  'entrenador_individual', 'admin_individual'...) y olvidarse de UNO
      //  dejaria sin registrarse a ese perfil, en produccion y en silencio.
      //  Aqui solo se cierra lo que de verdad escala: 'superadmin' (la puerta
      //  de setCustomClaims) y 'admin' (que `sendInviteEmail` trata como SA).
      //
      //  ⚠️ EL ALTA REAL DEL SUPERADMIN NO SE ROMPE: auth.js le pone
      //  role:'superadmin' e isAuthorized:true, pero su correo esta en
      //  cronos_config/superadmins, asi que entra por la PRIMERA rama
      //  (isSuperAdmin()) y ni siquiera llega a esta comprobacion.
      //
      //  ⚠️ LO QUE ESTO NO ARREGLA: `sendInviteEmail` y `registerStaffUid`
      //  siguen fiandose del `role` del documento sin exigir isAuthorized, asi
      //  que un doc auto-creado con role:'director' todavia les vale. No es
      //  escalada de datos (las reglas exigen isAuthorized+status para
      //  isClubDirectorOf), pero hay que cerrarlo en el lado de las functions.
      //
      //  Cubierto por scripts/test_sec_role_escalation.js, que ejecuta los
      //  MISMOS casos contra las reglas SIN el parche y CON el parche.
      // ══════════════════════════════════════════════════════════════════
      allow create: if isAuth() && (
        isSuperAdmin() ||
        (request.auth.uid == userId
         && request.resource.data.get('isAuthorized', false) == false
         && request.resource.data.get('status', '') != 'active'
         && !(request.resource.data.get('role', '') in ['superadmin', 'admin']))
      );
      // FIX (multi-rol): se permite que el usuario actualice su propio
      // 'allRoles' para AÑADIR roles PENDIENTES (necesario para el flujo
      // "añadir rol a cuenta existente"). La escalada real se sigue
      // bloqueando porque los campos de RAÍZ que controlan el acceso
      // efectivo ('role', 'isAuthorized', 'status', 'clubId', 'clubName',
      // 'authorizedAt', 'authorizedBy', 'blockedAt') permanecen prohibidos
      // para el propio usuario. El gate de entrada (auth.js) NO confía en
      // 'allRoles[].isAuthorized' del cliente: solo activa un rol cuando la
      // RAÍZ 'isAuthorized' es true (escrita por el SA vía Admin SDK).
      // SEC-C1 (endurecido): se ELIMINO la excepcion v182 que permitia al
      // usuario escribir su propio 'clubId'. Un usuario podia fijar un clubId
      // AJENO (non-null) y obtener acceso cross-club via userDocClubId().
      // Ahora 'clubId' vuelve a ser NO escribible por el cliente bajo ningun
      // caso: la migracion del clubId a la raiz la hace EXCLUSIVAMENTE el
      // Admin SDK, via la Cloud Function syncRootClubId() (valida server-side
      // que el clubId pertenece al usuario) o el trigger autoSetClaimsOnApproval
      // (lo puebla al aprobar). 'clubId' esta en la lista prohibida de hasAny().
      //
      // v474 (tercera rama) · EL ADMINISTRADOR DEL CLUB DECIDE SOBRE LAS
      // SOLICITUDES DE SU CLUB. Sin ella, "Solicitudes de Registro" del Panel
      // de Administrador de Club era decorativa para todo el que no fuera el
      // SuperAdmin: aceptar, rechazar y bloquear escriben isAuthorized/status
      // en el documento de OTRO usuario, que hasta aqui solo el SA podia
      // tocar. Sintoma reportado: "Error al rechazar: Missing or insufficient
      // permissions", con la solicitud colgada para siempre en el panel.
      // Acotada por los DOS lados: el documento tiene que ser YA de su club
      // (isAdminOfClub sobre el clubId EXISTENTE, nunca el entrante) y solo
      // puede cambiar los campos de isMembershipDecision().
      allow update: if isSuperAdmin() ||
        (isAuth() && request.auth.uid == userId
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'isAuthorized', 'status', 'clubId', 'clubName', 'authorizedAt', 'authorizedBy', 'blockedAt'])
        ) ||
        (isAdminOfClub(resource.data.get('clubId', null)) && isMembershipDecision());

      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // COLECCIÓN: clubs
    // SEC-008: Require authentication for read
    // ============================================================
    match /clubs/{clubId} {
      allow read: if isAuth();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
                       isClubAdmin(clubId) ||
                       (isIndividualAdmin(clubId) &&
                        isIndividualEntity(resource.data)) ||
                       (isClubDirectorOf(clubId) && isClubConfigOnlyUpdate());
                       // NOTA (refactor v188): se ELIMINO la rama que permitia a
                       // director/coordinador escribir directorUids/coordinatorUids
                       // desde el cliente. Ese registro lo hace EXCLUSIVAMENTE la
                       // Cloud Function registerStaffUid (Admin SDK), que valida el
                       // rol server-side. La regla cliente permitia escalada
                       // cross-club (un director del club A podia anadirse al
                       // directorUids del club B) y era innecesaria.
                       //
                       // NUEVO (pestanya "Config." del Director, 2026-07-29): el
                       // DIRECTOR de ESTE club puede actualizar la configuracion
                       // deportiva, y NADA MAS. Sin esta rama la pestanya no
                       // tenia duenyo funcional: se le mostraba al director pero
                       // su guardado siempre fallaba con permission-denied.
                       //
                       // POR QUE ESTO NO REABRE EL AGUJERO DE v188: aquella rama
                       // era ABIERTA (cualquier campo, y el director se resolvia
                       // sin atar al club, de ahi la escalada cross-club). Esta:
                       //   1. exige que el club del director sea ESTE (isClubDirectorOf
                       //      compara users/{uid}.clubId con {clubId}), asi que no
                       //      puede tocar otro club;
                       //   2. limita la escritura con hasOnly a TRES campos de
                       //      configuracion deportiva. directorUids, coordinatorUids,
                       //      adminUid, plan, status y expiresAt quedan FUERA, asi que
                       //      no hay forma de escalar privilegios ni de tocar el plan.
                       // El registro de UIDs de staff sigue siendo exclusivo de la
                       // Cloud Function registerStaffUid.
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // SUBCOLECCION: clubs/{clubId}/team_archives/{teamId}
    // ------------------------------------------------------------
    // El trabajo que un entrenador dejo al ser ELIMINADO, guardado en
    // su CATEGORIA para que lo herede quien venga detras.
    //
    // Por que existe: la plantilla vive en users/{uid}/cronos_data,
    // una SUBCOLECCION. Firestore no la borra al borrar el documento
    // del usuario, y su regla es `request.auth.uid == userId` sin rama
    // de SuperAdmin: en cuanto ese uid deja de existir NADIE puede
    // leerla nunca mas. La Cloud Function archiveAndDeleteCoach la
    // copia aqui ANTES de borrar la cuenta.
    //
    // ESCRITURA: `if false` A PROPOSITO. Solo la escribe esa Function
    // con el Admin SDK, que no pasa por estas reglas. Si el cliente
    // pudiera escribir aqui, cualquiera podria falsear o vaciar el
    // archivo historico de un equipo.
    //
    // LECTURA: los miembros autorizados del club. El entrenador
    // entrante tiene que poder abrirlo, que es el objetivo entero.
    // ============================================================
    match /clubs/{clubId}/team_archives/{teamId} {
      allow read: if isAuth() && (
                       isSuperAdmin() ||
                       sameClubAsDoc(clubId) ||
                       isClubAdminOf(clubId)
                     );
      allow write: if false;
    }

    // ============================================================
    // COLECCIÓN: clubs/{clubId}/team_rosters/{teamId}
    //
    // COPIA SIN DATOS PERSONALES de la plantilla de cada equipo. Existe
    // para las PLAZAS DE APOYO (2026-08-12): un entrenador puede convocar
    // puntualmente a un jugador de otra categoría o del filial, y para
    // elegirlo necesita ver los dorsales y alias de ese otro equipo.
    //
    // ⚠️⚠️ POR QUÉ ESTA COLECCIÓN Y NO ABRIR users/{uid}/cronos_data:
    // ahí la plantilla NO vive sola — comparte documento con
    // cronos_email_config, que son los CORREOS Y TELÉFONOS DE TODOS LOS
    // PADRES del equipo. Relajar aquella regla para que se vieran los
    // dorsales habría publicado de paso el directorio de contactos del club
    // entero. Aquí sólo se escribe { ficha, dorsal, nombre, alias }, que es
    // exactamente lo que el autor autorizó a compartir.
    //
    // ESCRITURA: sólo el entrenador dueño del equipo.
    // ⚠️ En el update se compara contra resource.data (lo GUARDADO) Y contra
    // el payload entrante. Mirar sólo el entrante dejaría que cualquiera
    // reescribiese la plantilla de otro equipo poniéndose a sí mismo como
    // coachUid — es literalmente el agujero que se cerró en
    // cronos_player_reports en v435.
    // ============================================================
    match /clubs/{clubId}/team_rosters/{teamId} {
      allow read: if isAuth() && (
                       isSuperAdmin() ||
                       sameClubAsDoc(clubId) ||
                       isClubAdminOf(clubId) ||
                       userDocClubId(clubId)
                     );
      allow create: if isAuth() &&
                       request.auth.uid == request.resource.data.get('coachUid', null);
      allow update: if isAuth() &&
                       request.auth.uid == resource.data.get('coachUid', null) &&
                       request.auth.uid == request.resource.data.get('coachUid', null);
      allow delete: if isAuth() && (
                       isSuperAdmin() ||
                       request.auth.uid == resource.data.get('coachUid', null)
                     );
    }

    // ============================================================
    // COLECCIÓN: clubs/{clubId}/attendance/{teamId}__{YYYY-MM}
    //
    // CONTROL DE ASISTENCIA (2026-08-13). Un documento por equipo y mes con
    // quién vino a cada entrenamiento y a cada partido, y con qué motivo
    // faltó quien faltó.
    //
    // ⚠️⚠️ POR QUÉ LA LECTURA **NO** ES `sameClubAsDoc` A SECAS, que es lo que
    // usa team_rosters justo aquí arriba: en este documento están las FALTAS
    // DE LOS 25 JUGADORES con su causa, y un padre del club lleva el mismo
    // claim `clubId` que un entrenador. Con el predicado de team_rosters,
    // cualquier padre podría leerse el parte entero del equipo. Aquí se exige
    // además que el usuario NO sea una cuenta de padre.
    //
    // 🔑 SE COMPRUEBA `role != 'parent'` Y NO `role in [...]`: se verificó
    // contra producción que los ENTRENADORES tienen users/{uid}.role == 'user'
    // (el rol de entrenador vive dentro de allRoles, no en la raíz). Una lista
    // blanca como la de isTechStaffByDoc() —que pide 'coach'— habría dejado
    // fuera a TODOS los entrenadores reales, que son justo quienes escriben.
    // Con la lista negra pasan entrenador, director, coordinador y admin, y
    // no pasa la cuenta que sólo es de padre. Quien es padre Y entrenador
    // pasa, que es lo correcto: es entrenador.
    //
    // El padre NO lee este documento: lee su extracto en attendance_players.
    // ============================================================
    function attendanceStaff(clubId) {
      return isAuth() && (
               isSuperAdmin() ||
               isClubAdminOf(clubId) ||
               (
                 (sameClubAsDoc(clubId) || userDocClubId(clubId))
                 && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                 && get(/databases/$(database)/documents/users/$(request.auth.uid))
                      .data.get('role', '') != 'parent'
               )
             );
    }

    match /clubs/{clubId}/attendance/{docId} {
      // Entrenador, director, coordinador y administrador del club. El
      // director y el coordinador ven TODAS las categorías, que es lo que
      // necesitan para su seguimiento.
      allow read: if attendanceStaff(clubId);
      allow create, update: if attendanceStaff(clubId);
      allow delete: if isAuth() && (isSuperAdmin() || isClubAdminOf(clubId));
    }

    // ============================================================
    // COLECCIÓN: clubs/{clubId}/attendance_players/{teamId}__{ficha}
    //
    // EXTRACTO POR JUGADOR para que cada padre vea LO DE SU HIJO Y NADA MÁS.
    //
    // 🔑🔑🔑 EXISTE PORQUE LAS REGLAS NO PUEDEN FILTRAR UN MAPA. El documento
    // del equipo lleva las marcas de los 25 jugadores en un solo campo
    // `marks`; no hay forma de conceder lectura "sólo de la clave ALC07". O
    // se lee entero o no se lee. Por eso el dispositivo del entrenador
    // publica además este extracto de UN jugador.
    //
    // 🔑 `parentUids` lo escribe el cliente resolviendo cronos_player_links
    // (el mismo puente que ya usan los informes individuales). La regla no
    // puede consultar links por query —en reglas no hay queries—, así que la
    // pertenencia viaja DENTRO del documento.
    // ============================================================
    match /clubs/{clubId}/attendance_players/{docId} {
      allow read: if attendanceStaff(clubId) ||
                     (isAuth() && request.auth.uid in resource.data.get('parentUids', []));
      allow create, update: if attendanceStaff(clubId);
      allow delete: if isAuth() && (isSuperAdmin() || isClubAdminOf(clubId));
    }

    // ============================================================
    // COLECCIÓN: clubs_public
    // Espejo PÚBLICO de clubs con solo 3 campos: name, type, status.
    // Permite que el formulario de registro liste los clubes/entes
    // disponibles SIN autenticación, manteniendo 'clubs' protegida.
    // La escritura SOLO la realiza la Cloud Function syncClubPublic
    // (Admin SDK), por eso aquí no se permite write desde el cliente.
    // ============================================================
    match /clubs_public/{clubId} {
      allow read: if true;
      allow write: if false;
    }

    // ══════════════════════════════════════════════════════════════════
    //  🎟️ SEC-INV (auditoria 2026-08-26) · INVITACIONES CON TOKEN OPACO
    //
    //  Hasta hoy el enlace de invitacion era:
    //    ?register=true&email=juan%40x.es&role=club_admin&clubName=CD+DORAMAS
    //  O sea DATOS PERSONALES EN CLARO dentro de una URL — que queda en el
    //  historial del navegador, en los registros del servidor de correo y en
    //  la cabecera `Referer` de cualquier recurso externo. Y no caducaba ni se
    //  consumia: servia para siempre y para cualquiera que la reenviara.
    //
    //  Ahora el enlace es `?invite=<token>` y los datos viven aqui.
    //
    //  🔑 EL TOKEN **ES** EL SECRETO, y por eso `get` no pide autenticacion:
    //  quien abre la invitacion todavia NO tiene cuenta — ese es justo el
    //  momento del alta. Lo que lo hace seguro es que el id sea largo y
    //  aleatorio.
    //
    //  ⚠️⚠️ Y POR ESO `list` VA APARTE Y CERRADO. En Firestore `read` = `get` +
    //  `list`: un `allow read: if true` habria dejado que cualquiera se
    //  descargase la coleccion ENTERA con `getDocs(collection('invites'))` y
    //  con ella todos los correos invitados. Separarlos es toda la diferencia
    //  entre "hay que conocer el token" y "no hace falta conocer nada".
    //
    //  ⚠️ CADUCIDAD Y UN SOLO USO, EN LA REGLA y no solo en el cliente. Las dos
    //  fallan hacia el NO: si `expiresAt` falta, la comparacion se evalua
    //  contra `request.time` y da falso; si `usedAt` ya tiene valor, no se lee.
    //
    //  ⚠️ El `update` solo deja marcar el consumo (`usedAt`/`usedBy`), y con el
    //  uid de quien lo consume: no se puede reescribir el correo ni el rol de
    //  una invitacion ajena para colarse en otro club.
    // ══════════════════════════════════════════════════════════════════
    match /invites/{token} {
      allow get: if resource.data.get('usedAt', null) == null
                 && request.time < resource.data.get('expiresAt', request.time);
      allow list: if isSuperAdmin();
      allow create: if isAuth()
                    && (isSuperAdmin() || isRegisteredUser())
                    && request.resource.data.get('createdBy', null) == request.auth.uid
                    && request.resource.data.get('usedAt', null) == null;
      allow update: if isAuth()
                    && resource.data.get('usedAt', null) == null
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['usedAt', 'usedBy'])
                    && request.resource.data.get('usedBy', null) == request.auth.uid;
      allow delete: if isSuperAdmin()
                    || (isAuth() && resource.data.get('createdBy', null) == request.auth.uid);
    }

    // ============================================================
    // COLECCIÓN: individuals
    // FIX: antes era "if isAuth()" — cualquier usuario autenticado
    // podía leer los entes individuales de otros clubs.
    // ============================================================
    match /individuals/{entityId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        userDocClubId(resource.data.get('clubId', null)) ||
        // Propiedad por email: el admin individual (aún sin claims tras el alta)
        // lee SU propia entidad. No renovable: depende del email verificado del
        // token, no del momento de autenticación.
        (('email' in request.auth.token) && resource.data.get('email', null) == request.auth.token.email) ||
        transitionalRead(resource.data.get('clubId', null))
      );
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
                       (isAuth() &&
                        ('email' in request.auth.token) && resource.data.get('email', null) == request.auth.token.email);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // COLECCIÓN: platform_requests
    // ============================================================
    match /platform_requests/{reqId} {
      // ⚠️ SOBRE LAS CONSULTAS (list), v474: Firestore resuelve el permiso de
      // una consulta SIN leer los documentos — la condicion tiene que quedar
      // garantizada por los filtros de la propia consulta. Por eso el listado
      // del panel (`where('clubId','==',clubId)`) SI pasa y una consulta por
      // `userUid` a secas NO: `resource.data.clubId` es desconocido y ninguna
      // rama puede darse por cierta. La cura es del lado del CLIENTE — filtrar
      // tambien por clubId—, no de aqui: relajar esta regla para que cualquier
      // consulta valiera significaria abrir la coleccion entera.
      allow read: if isSuperAdmin() ||
                     (isAuth() && (
                       sameClubAsDoc(resource.data.get('clubId', null)) ||
                       isAdminOfClub(resource.data.get('clubId', null)) ||
                       request.auth.uid == resource.data.get('requestedBy', null) ||
                       request.auth.uid == resource.data.get('userId', null) ||
                       // v474 · el campo que ESCRIBEN auth.js y el panel se llama
                       // 'userUid'; 'userId' (arriba) no existe en ningun documento,
                       // asi que la rama "el propio solicitante lee su solicitud"
                       // nunca se cumplia. Se deja la vieja por si hay docs legacy.
                       request.auth.uid == resource.data.get('userUid', null) ||
                       (('clubId' in request.auth.token) && request.auth.token.clubId == resource.data.get('individualOwnerId', null))
                     ));
      allow create: if isAuth();
      allow update: if isSuperAdmin() ||
                       (isAuth() && sameClubAsDoc(resource.data.get('clubId', null)));
      // v474 · El administrador del club (o de la entidad individual) RETIRA
      // las solicitudes de registro de los suyos. Antes solo podia el
      // SuperAdmin, asi que al rechazar desde el Panel de Administrador de
      // Club saltaba "Missing or insufficient permissions" y la solicitud se
      // quedaba colgada en el listado sin forma de retirarla.
      //
      // ⚠️ Deliberadamente MAS ESTRECHO que el `allow update` de arriba: aquel
      // se conforma con sameClubAsDoc(), que es cierto para cualquier miembro
      // autorizado del club. Borrar la solicitud de otro exige ser el ADMIN.
      // La segunda rama cubre las altas bajo una entidad individual
      // (ind_reg_*), que llevan individualOwnerId y NO llevan clubId.
      allow delete: if isSuperAdmin() ||
                       isAdminOfClub(resource.data.get('clubId', null)) ||
                       isIndividualAdmin(resource.data.get('individualOwnerId', null));
    }

    // ============================================================
    // COLECCIÓN: matches
    // FIX: antes era "allow read: if isAuth()"
    // ============================================================
    match /matches/{matchId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        sameClub(resource.data.get('clubId', null)) ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        transitionalRead(resource.data.get('clubId', null))
      );
      allow create: if isAuth() && (
        isSuperAdmin() ||
        sameClub(request.resource.data.get('clubId', null)) ||
        transitionalRead(request.resource.data.get('clubId', null))
      );
      allow update: if isAuth() && (
        isSuperAdmin() ||
        sameClub(resource.data.get('clubId', null)) ||
        transitionalRead(resource.data.get('clubId', null))
      );
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // COLECCIÓN: players (jugadores — pueden ser MENORES)
    // ============================================================
    match /players/{playerId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        sameClub(resource.data.get('clubId', null)) ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        transitionalRead(resource.data.get('clubId', null))
      );
      allow create: if isAuth() && (
        isSuperAdmin() ||
        sameClub(request.resource.data.get('clubId', null)) ||
        transitionalRead(request.resource.data.get('clubId', null))
      ) && isValidPlayerData(request.resource.data);
      allow update: if isAuth() && (
        isSuperAdmin() ||
        sameClub(resource.data.get('clubId', null)) ||
        transitionalRead(resource.data.get('clubId', null))
      ) && isValidPlayerData(request.resource.data);
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // COLECCIÓN: teams
    // ============================================================
    match /teams/{teamId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        sameClub(resource.data.get('clubId', null)) ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        transitionalRead(resource.data.get('clubId', null))
      );
      allow create: if isAuth() && (
        isSuperAdmin() ||
        sameClub(request.resource.data.get('clubId', null)) ||
        transitionalRead(request.resource.data.get('clubId', null))
      );
      allow update: if isAuth() && (
        isSuperAdmin() ||
        sameClub(resource.data.get('clubId', null)) ||
        transitionalRead(resource.data.get('clubId', null))
      );
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // COLECCIÓN: formations
    // ============================================================
    match /formations/{formationId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        sameClub(resource.data.get('clubId', null)) ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        transitionalRead(resource.data.get('clubId', null))
      );
      allow create: if isAuth() && (
        isSuperAdmin() ||
        sameClub(request.resource.data.get('clubId', null)) ||
        transitionalRead(request.resource.data.get('clubId', null))
      );
      allow update: if isAuth() && (
        isSuperAdmin() ||
        sameClub(resource.data.get('clubId', null)) ||
        transitionalRead(resource.data.get('clubId', null))
      );
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // COLECCIÓN: substitutions
    // ============================================================
    match /substitutions/{subId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        sameClub(resource.data.get('clubId', null)) ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        transitionalRead(resource.data.get('clubId', null))
      );
      allow create: if isAuth() && (
        isSuperAdmin() ||
        sameClub(request.resource.data.get('clubId', null)) ||
        transitionalRead(request.resource.data.get('clubId', null))
      );
      allow update: if isAuth() && (
        isSuperAdmin() ||
        sameClub(resource.data.get('clubId', null)) ||
        transitionalRead(resource.data.get('clubId', null))
      );
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // COLECCIÓN: events
    // ============================================================
    match /events/{eventId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        sameClub(resource.data.get('clubId', null)) ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        transitionalRead(resource.data.get('clubId', null))
      );
      allow create: if isAuth() && (
        isSuperAdmin() ||
        sameClub(request.resource.data.get('clubId', null)) ||
        transitionalRead(request.resource.data.get('clubId', null))
      );
      allow update: if isAuth() && (
        isSuperAdmin() ||
        sameClub(resource.data.get('clubId', null)) ||
        transitionalRead(resource.data.get('clubId', null))
      );
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // COLECCIÓN: cronos_messages
    // SEC-005: Restrict create
    // ============================================================
    match /cronos_messages/{threadId} {
      // FIX (auditoría 2026-07-22 — chats entrenador/director/coordinador):
      // se añade una rama explícita por `staffUid` (igual patrón ya usado en
      // cronos_player_reports.staffUids), como respaldo directo para el
      // destinatario staff de un hilo entrenador<->director/coordinador. No
      // amplía la superficie de acceso: solo cubre al UID que el propio
      // remitente escribió como destinatario en el documento, exactamente el
      // mismo principio que ya cubre `coachUid`/`parentUid`. Antes de este
      // fix, un hilo staff solo era legible por el staff vía `participants`
      // (requiere que YA estuviera en el array) o por claims de club (requiere
      // que `role`+`clubId` estuvieran propagados) — ambos con historial de
      // fallos parciales en este proyecto (ver CORRECCIONES_ESTADO.md).
      // FIX (auditoría 2026-07-22 — "Missing or insufficient permissions" al
      // abrir una conversación NUEVA, sin mensajes previos): el patrón de
      // envío (getDoc para comprobar si el hilo existe, y solo entonces
      // decidir entre updateDoc/setDoc — usado por todas las funciones de
      // envío, coach/staff/padre) hace un `get()` sobre un threadId que
      // puede NO EXISTIR aún (primera conversación de un par de personas).
      // Cuando el documento no existe, `resource` es null en la evaluación
      // de la regla: CUALQUIER rama que lea `resource.data.X` genera un
      // error de evaluación (no "false", un ERROR), y como ninguna rama de
      // este `allow read` es independiente de `resource.data` para un
      // usuario normal (solo `isSuperAdmin()` lo es), la condición completa
      // termina en error -> denegado, aunque ese mismo usuario SÍ tendría
      // permiso en cuanto el documento existiera. Añadir `resource == null`
      // es seguro: un documento inexistente no tiene datos que proteger
      // (`getDoc` devuelve `exists:false` sin payload para CUALQUIER
      // usuario, da igual quién pregunte), así que no amplía el acceso a
      // ningún dato real.
      // ══════════════════════════════════════════════════════════════
      // ⚠️ v437 · EL CAMPO AUSENTE, no solo el documento ausente
      // ══════════════════════════════════════════════════════════════
      // El comentario de arriba ya describe el mecanismo —"CUALQUIER rama que
      // lea resource.data.X genera un error"— pero se parcheo SOLO para el
      // documento inexistente (`resource == null`). El otro caso, el del
      // documento que SI existe pero al que le falta una clave, seguia igual:
      // leer una clave AUSENTE de un mapa LANZA, y un error en la condicion
      // equivale a DENY para la condicion ENTERA, no solo para esa rama.
      //
      // Consecuencia real: un hilo sin `participants` —o sin coachUid, o sin
      // parentUid, o sin clubId— daba "Missing or insufficient permissions" a
      // quien SI tenia derecho a leerlo, porque la evaluacion reventaba antes
      // de llegar a su rama. Y el sintoma es enganoso: parece un problema de
      // permisos o de claims, cuando es un campo que no esta.
      //
      // Ahora TODAS las lecturas usan .get(campo, default) y ninguna rama puede
      // tumbar a las demas. Mismo arreglo que en cronos_player_reports (v435) y
      // en el `allow delete` de aqui mismo (v436).
      //
      // Nota sobre staffUid: `(x != null && uid == x)` se queda en
      // `uid == .get('staffUid', null)`, que es equivalente —si el campo falta,
      // el uid nunca es null— y ademas no puede lanzar.
      allow read: if isAuth() && (
        resource == null ||
        isSuperAdmin() ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        request.auth.uid in resource.data.get('participants', []) ||
        request.auth.uid == resource.data.get('coachUid', null) ||
        request.auth.uid == resource.data.get('parentUid', null) ||
        request.auth.uid == resource.data.get('staffUid', null) ||
        userDocClubId(resource.data.get('clubId', null)) ||
        transitionalRead(resource.data.get('clubId', null))
      );
      allow create: if isAuth() && (
        isSuperAdmin() ||
        sameClub(request.resource.data.get('clubId', null)) ||
        request.auth.uid in request.resource.data.get('participants', []) ||
        request.auth.uid == request.resource.data.get('coachUid', null) ||
        request.auth.uid == request.resource.data.get('parentUid', null) ||
        request.auth.uid == request.resource.data.get('staffUid', null)
      );
      allow update: if isAuth() && (
        isSuperAdmin() ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        request.auth.uid in resource.data.get('participants', []) ||
        request.auth.uid == resource.data.get('coachUid', null) ||
        request.auth.uid == resource.data.get('parentUid', null) ||
        request.auth.uid == resource.data.get('staffUid', null) ||
        userDocClubId(resource.data.get('clubId', null))
      );
      // ⚠️ v436 · isSuperAdmin() VA PRIMERO y todas las lecturas usan
      // .get(campo, default). Leer una clave AUSENTE de un mapa LANZA, y un
      // error equivale a DENY para la condicion ENTERA: un hilo sin
      // `participants` —o sin coachUid/parentUid— hacia fallar la evaluacion
      // ANTES de llegar a la rama del SuperAdmin, que asi no podia borrarlo
      // aunque la regla dijera que si. Se descubrio al construir el vaciado de
      // temporada (v436), que borra hilos del club: habria fallado en silencio
      // sobre justo los documentos mas viejos, que son los que peor formados
      // estan. Misma trampa que en cronos_player_reports (v435).
      allow delete: if isAuth() &&
                    (isSuperAdmin() ||
                     request.auth.uid in resource.data.get('participants', []) ||
                     request.auth.uid == resource.data.get('coachUid', null) ||
                     request.auth.uid == resource.data.get('parentUid', null) ||
                     request.auth.uid == resource.data.get('staffUid', null));
    }

    // ============================================================
    // COLECCIÓN: cronos_notifications
    // SEC-004/SEC-015: Restrict create
    // ============================================================
    match /cronos_notifications/{notifId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        request.auth.uid == resource.data.get('userId', null) ||
        request.auth.uid == resource.data.get('parentUid', null) ||
        request.auth.uid == resource.data.get('coachUid', null) ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        userDocClubId(resource.data.get('clubId', null))
      );
      allow create: if isAuth() && (
        isSuperAdmin() ||
        sameClubAsDoc(request.resource.data.get('clubId', null)) ||
        request.auth.uid == request.resource.data.get('coachUid', null) ||
        request.auth.uid == request.resource.data.get('userId', null) ||
        // FIX (C2): fallback para entrenador sin custom claim clubId
        userDocClubId(request.resource.data.get('clubId', null))
      );
      allow update: if isAuth() && (
        isSuperAdmin() ||
        request.auth.uid == resource.data.get('userId', null) ||
        request.auth.uid == resource.data.get('parentUid', null) ||
        request.auth.uid == resource.data.get('coachUid', null) ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        userDocClubId(resource.data.get('clubId', null))
      );
      allow delete: if isAuth() && (
        isSuperAdmin() ||
        request.auth.uid == resource.data.get('userId', null) ||
        request.auth.uid == resource.data.get('parentUid', null) ||
        request.auth.uid == resource.data.get('coachUid', null) ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        userDocClubId(resource.data.get('clubId', null))
      );
    }

    // ============================================================
    // COLECCIÓN: cronos_player_reports
    // SEC-013: Validate club on create
    // ============================================================
    match /cronos_player_reports/{reportId} {
      // ⚠️ v435 · TODAS LAS LECTURAS DEL DOCUMENTO USAN .get(campo, null).
      // En el lenguaje de reglas, leer una clave AUSENTE de un mapa LANZA, y un
      // error en la condicion equivale a DENY. Aqui se accedia directo a
      // `.parentUid` y `.coachUid`, campos que un informe COLECTIVO no lleva:
      // evaluar esta condicion contra un colectivo tiraba
      // "Property parentUid is undefined on object" y denegaba POR AVERIA, no
      // por logica. Funcionaba de casualidad cuando el resultado esperado era
      // denegar, y cualquier reordenacion de las ramas podia dejar sin leer sus
      // informes a quien si tiene derecho. Es la misma trampa que ya se pago en
      // el `create` de live_matches (2026-07-29). Detectado con el test de
      // comportamiento en v435: una lectura estatica no lo ve.
      allow read: if isAuth() && (
        isSuperAdmin() ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        request.auth.uid == resource.data.get('coachUid', null) ||
        request.auth.uid == resource.data.get('parentUid', null) ||
        // FIX: directores/coordinadores reciben informes de staff aunque su
        // token aún NO tenga el custom claim 'clubId' (claims sin propagar o
        // token caducado). El informe incluye staffUids con los UIDs de los
        // destinatarios de staff (ver panel.js), así que permitimos leer a
        // quien esté listado explícitamente. Esto NO amplía la superficie:
        // solo accede el staff destinatario del propio documento.
        (resource.data.get('staffUids', null) != null &&
         request.auth.uid in resource.data.get('staffUids', [])) ||
        // FIX (entrenador sin claim): miembros del club según users/{uid}.clubId.
        userDocClubId(resource.data.get('clubId', null)) ||
        transitionalRead(resource.data.get('clubId', null))
      );
      allow create: if isAuth() && (
        isSuperAdmin() ||
        sameClub(request.resource.data.get('clubId', null)) ||
        request.auth.uid == request.resource.data.get('coachUid', null) ||
        // FIX (entrenador sin claim): autor miembro del club por users/{uid}.
        userDocClubId(request.resource.data.get('clubId', null))
      );
      // ══════════════════════════════════════════════════════════════
      // v435 · CRITERIO DEL AUTOR PARA LOS INFORMES
      // ══════════════════════════════════════════════════════════════
      // Los informes son PURAMENTE DEPORTIVOS: analizan lo ocurrido en el
      // campo y no llevan datos personales sensibles. Por eso aqui no rige la
      // congelacion del partido (v434), sino un modelo de CONTROL POR ROL:
      //   · COLECTIVOS   -> los gestionan Director Deportivo, Coordinador y
      //                     Entrenador del club.
      //   · INDIVIDUALES -> el padre tiene control total sobre los de su hijo:
      //                     los descarga y los borra cuando quiera.
      //   · El SuperAdmin puede vaciar al cerrar la temporada.
      allow update: if isAuth() && (
        isSuperAdmin() ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        request.auth.uid == resource.data.get('coachUid', null) ||
        // ⚠️ v435 · ELIMINADA la rama `request.auth.uid ==
        // request.resource.data.coachUid`. Leia el documento ENTRANTE, no el
        // guardado: CUALQUIER usuario autenticado podia reescribir CUALQUIER
        // informe sin mas que ponerse a si mismo como coachUid en el payload.
        // El caso legitimo que decia cubrir —"el autor reescribe su propio
        // informe"— ya lo cubre la rama de arriba, que compara contra
        // resource.data (lo que hay guardado) y por tanto no se puede falsear.
        // FIX v2: staff (director/coordinador) puede añadir su UID a dismissedBy
        // para ocultar el informe de su panel individual sin afectar a otros.
        (resource.data.get('staffUids', null) != null &&
         request.auth.uid in resource.data.get('staffUids', []) &&
         request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['dismissedBy'])) ||
        // FIX v4: el staff destinatario (director/coordinador) oculta el informe
        // de SU panel añadiendo su propio UID a dismissedByStaff. El doc físico
        // compartido NO se borra: cada rol ve/oculta de forma independiente. Solo
        // se permite modificar el campo dismissedByStaff (no se toca el contenido
        // del informe), restringido a UIDs listados en staffUids del propio doc.
        (resource.data.get('staffUids', null) != null &&
         request.auth.uid in resource.data.get('staffUids', []) &&
         request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['dismissedByStaff'])) ||
        // FIX (permisos dismiss): el staff (director/coordinador, según su doc
        // users/{uid}.role) puede ocultar de SU panel CUALQUIER informe añadiendo
        // su UID a dismissedByStaff, incluso si el doc NO trae staffUids ni un
        // clubId que case con users/{uid}.clubId (docs legacy o variantes
        // _coach_pN / _pN). Se restringe a modificar SOLO dismissedByStaff, así
        // que no puede alterar el contenido del informe de otros usuarios.
        (isStaffRoleByDoc() &&
         request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['dismissedByStaff'])) ||
        // FIX v2: padres pueden añadir su UID a dismissedBy para ocultar
        // informes de su panel sin afectar a otros usuarios.
        (request.auth.uid == resource.data.get('parentUid', null) &&
         request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['dismissedBy'])) ||
        userDocClubId(resource.data.get('clubId', null))
      );
      // ══════════════════════════════════════════════════════════════
      // 2026-08-13 · QUIÉN DESTRUYE UN INFORME COLECTIVO
      // ------------------------------------------------------------
      // Regla de producto del autor: el ENTRENADOR y el COORDINADOR sólo
      // OCULTAN de su panel (dismissedBy / dismissedByStaff, que siguen
      // permitidos arriba en el update). La purga física —que descuenta los
      // datos del acumulado de temporada del club— es EXCLUSIVA del DIRECTOR
      // DEPORTIVO, máximo responsable deportivo.
      //
      // ⚠️ ESTO RETIRA DOS PERMISOS QUE ANTES EXISTÍAN, y es intencionado:
      //   · el COORDINADOR entraba por la rama isTechStaffByDoc() de v435;
      //   · el ENTRENADOR AUTOR entraba por `coachUid`, que no distinguía
      //     entre su copia individual y el informe colectivo compartido.
      // Ahora `coachUid` sólo alcanza lo que NO es de staff.
      //
      // ⚠️ SE INCLUYE isClubAdminOf: en los datos reales NO hay ninguna
      // cuenta con users/{uid}.role == 'director' (el director del club de
      // pruebas tiene role 'club_admin' y su rol de director vive dentro de
      // allRoles, que las reglas no saben recorrer). Sin esta rama, NADIE
      // podría purgar y la función nacería muerta. Es el administrador del
      // club, que está por encima del director, no un rol lateral.
      allow delete: if isAuth() && (
        isSuperAdmin() ||
        // El coach autor conserva SUS copias no colectivas. El informe
        // compartido (staffReport) ya no: eso es del Director.
        (resource.data.get('staffReport', false) != true &&
         request.auth.uid == resource.data.get('coachUid', null)) ||
        // FIX v2: padres pueden borrar informes individuales dirigidos a ellos
        (request.auth.uid == resource.data.get('parentUid', null) &&
         resource.data.get('type', '') == 'parent_player_report') ||
        // FIX v3: padres pueden borrar docs legacy (rpt_*) dirigidos a ellos
        // que NO tienen type='parent_player_report' pero sí tienen su parentUid
        // y NO son docs de staff (staffReport=true) ni de coach (_forCoach=true)
        (request.auth.uid == resource.data.get('parentUid', null) &&
         resource.data.get('staffReport', false) != true &&
         resource.data.get('_forCoach', false) != true) ||
        // v435 · LOS COLECTIVOS LOS GESTIONA EL CUERPO TECNICO DEL CLUB.
        // Hasta v435 esta rama excluia los informes de staff
        // (`staffReport != true`): el director/coordinador solo podia OCULTARLOS
        // de su panel con dismissedByStaff, nunca borrarlos, asi que el
        // documento compartido no habia forma de eliminarlo salvo por el coach
        // autor o el SuperAdmin.
        //
        // ⚠️ PERO NO BASTA CON PERTENECER AL CLUB. El primer intento quito el
        // gate de staffReport dejando solo sameClubAsDoc/userDocClubId, y eso
        // daba el borrado de los informes COLECTIVOS a cualquier miembro del
        // club — LOS PADRES INCLUIDOS, porque su users/{uid}.clubId tambien
        // casa. El criterio del autor es Director Deportivo, Coordinador y
        // Entrenador, asi que el colectivo exige ademas rol tecnico.
        //
        // 2026-08-13 · isTechStaffByDoc() SUSTITUIDO por puedePurgarInformes.
        // Aquel predicado admitía director, coordinador, coach, club_admin e
        // individual_admin; la regla nueva deja fuera al coordinador y al
        // entrenador, que ocultan pero no destruyen.
        (resource.data.get('staffReport', false) == true
         && puedePurgarInformes(resource.data.get('clubId', null))) ||
        // Los que NO son de staff (individuales y sueltos) se quedan como
        // estaban: cualquier miembro del club puede borrarlos.
        (resource.data.get('staffReport', false) != true &&
         (sameClubAsDoc(resource.data.get('clubId', null)) ||
          userDocClubId(resource.data.get('clubId', null))))
      );
    }

    // ============================================================
    // COLECCIÓN: cronos_player_links
    // FIX CRÍTICO: antes era "allow read, write: if isAuth()"
    // ============================================================
    match /cronos_player_links/{linkId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        isLinkOwner() ||
        isLinkClubMember() ||
        // FIX (C2): fallback para entrenador sin custom claim clubId
        userDocClubId(resource.data.get('clubId', null)) ||
        transitionalRead(resource.data.get('clubId', null))
      );
      allow create: if isAuth() && (
        isSuperAdmin() ||
        sameClub(request.resource.data.get('clubId', null)) ||
        sameClubAsDoc(request.resource.data.get('clubId', null)) ||
        // FIX (C2): fallback para entrenador sin custom claim clubId
        userDocClubId(request.resource.data.get('clubId', null))
      );
      allow update: if isAuth() && (
        isSuperAdmin() ||
        isLinkOwner() ||
        isLinkClubMember()
      );
      allow delete: if isAuth() && (
        isSuperAdmin() ||
        isLinkClubMember()
      );
    }

    // ============================================================
    // COLECCIÓN: deletion_requests
    // ============================================================
    match /deletion_requests/{reqId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        request.auth.uid == resource.data.get('userId', null)
      );
      // 🔴 SEC-M01 (auditoria 2026-08-25) · antes: `if isAuth()`. Cualquiera
      // podia dejar constancia de una baja que no habia hecho, apuntando a
      // quien quisiera: contamina el unico rastro que queda de una accion
      // irreversible.
      // 🔑 `requestedBy` YA lo escribe el unico creador real
      // (js/admin/club/panel.js:2648, `requestedBy: me.uid`), asi que atarlo
      // al remitente no cambia una sola linea del cliente.
      allow create: if isAuth() &&
                       request.resource.data.get('requestedBy', null) == request.auth.uid;
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // COLECCIÓN: auth_deletion_failures
    // Cola de revisión: se escribe cuando deleteAuthUser (Cloud
    // Function) falla durante un borrado total. El documento incluye
    // 'requestedBy' = uid del admin que solicitó el borrado, así que
    // el create exige que coincida con el solicitante autenticado:
    // un usuario solo puede registrar fallos de SUS PROPIAS acciones
    // (no puede falsificar la identidad del solicitante ni inundar la
    // cola en nombre de otro). Contiene PII (email del usuario
    // borrado), por eso SOLO el SuperAdmin puede leer la cola.
    // Documentos inmutables: sin update; el SA puede purgar (delete)
    // tras resolver el fallo.
    // FIX: antes NO existía regla → caía en el catch-all (deny) y los
    // registros de fallo se perdían silenciosamente (el write quedaba
    // tragado por el try/catch del cliente).
    // ============================================================
    match /auth_deletion_failures/{failId} {
      allow read: if isSuperAdmin();
      allow create: if isAuth() &&
                       request.resource.data.get('requestedBy', null) == request.auth.uid;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // COLECCIÓN: live_matches
    // SEC-014: Restrict writes to same-club
    // P9 (Privacidad): los documentos de live_matches contienen datos
    // personales (coachEmail, nombres de jugadores —menores de edad—,
    // dorsales, nombre y colores de club). El rule anterior
    // `allow read: if true` exponía toda esa PII a cualquier persona en
    // Internet que conociera/adivinara un matchId, sin autenticación.
    // live.html y parent/panel.js solo consultan estos docs DESPUÉS de
    // iniciar sesión (checkUserAccess gatea por login + rol), por lo que
    // restringir la lectura a usuarios autenticados no rompe ningún flujo
    // legítimo y elimina la fuga de datos.
    // ============================================================
    match /live_matches/{matchId} {
      // ══════════════════════════════════════════════════════════════
      //  🔴🔴 SEC-A2 (auditoria 2026-08-25) · ACOTADO AL CLUB
      //
      //  Antes: `allow read: if isRegisteredUser()`, que es CUALQUIER usuario
      //  autenticado con isAuthorized:true — sin mirar su club. O sea que un
      //  padre de un club leia los partidos en vivo de TODOS los demas: alias
      //  de menores, dorsales, correo del entrenador, goles, tarjetas y
      //  LESIONES. El propio comentario de v-anterior enumera esa PII.
      //
      //  🔑 Y ERAN ENUMERABLES: `live_index` tenia la misma regla y ES la
      //  lista, asi que se sacaban todos los matchId de todos los clubes y con
      //  ellos se leian los documentos gordos. No habia que adivinar nada.
      //
      //  El arreglo anterior cerro "cualquiera en Internet". No cerro
      //  "cualquier usuario de OTRO club", que es el aislamiento por entidad
      //  que promete privacy.html.
      //
      //  ⚠️ LAS TRES RAMAS SON LAS TRES CONSULTAS QUE YA HACE EL VISOR desde
      //  v431/v433 (`clubId`, `createdBy`, `coachEmail`, fusionadas por id).
      //  Si se quita una, la lista de Partidos en Vivo se queda a medias: en
      //  Firestore una consulta se DENIEGA ENTERA si la regla no puede
      //  demostrar que todo lo que devuelve es legible.
      //
      //  ⚠️ SE USA `.get(campo, null)` Y NO EL ACCESO DIRECTO, y esto se
      //  MIDIO en vez de suponerlo. La primera version escribio
      //  `resource.data.clubId` creyendo que el analizador de consultas de
      //  Firestore solo reconoce el acceso directo para casar la regla con los
      //  `where`. Es FALSO: desplegadas las dos formas y lanzadas las consultas
      //  reales contra produccion con el token de un usuario normal, las seis
      //  comprobaciones dan lo mismo. Asi que manda el invariante de v438
      //  —nunca acceso directo, porque una clave ausente LANZA— que ademas
      //  fija el guard scripts/test_rules_no_direct_access.js.
      // ══════════════════════════════════════════════════════════════
      allow read: if isRegisteredUser() && (
        isSuperAdmin() ||
        sameClub(resource.data.get('clubId', null)) ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        userDocClubId(resource.data.get('clubId', null)) ||
        resource.data.get('createdBy', null) == request.auth.uid ||
        (('email' in request.auth.token) && resource.data.get('coachEmail', null) == request.auth.token.email)
      );

      // ══════════════════════════════════════════════════════════════
      // v434 · INMUTABILIDAD DEL PARTIDO TERMINADO
      // ══════════════════════════════════════════════════════════════
      // Regla de negocio: lo ocurrido en un partido no se puede reescribir.
      //   live    · status 'active'      -> se escribe con normalidad
      //   grace   · terminado hace < 2 h -> SOLO se pueden AÑADIR sucesos
      //   frozen  · terminado hace > 2 h -> ni edicion ni borrado
      // 2 h de gracia + 8 h congelado = las 10 h de retencion de v431, tras las
      // cuales `cleanupLiveMatches` lo borra desde el servidor.
      //
      // ⚠️ ESTA ES LA BARRERA DE VERDAD. El equivalente en el navegador
      // (js/match/immutability.js) es solo interfaz: apaga botones y evita
      // intentos que van a fallar, pero cualquiera puede saltarselo desde la
      // consola. Si cambian las horas hay que cambiarlas EN LOS DOS SITIOS —
      // no se pueden compartir constantes entre JS y el lenguaje de reglas.
      //
      // ⚠️ La Cloud Function `cleanupLiveMatches` usa el Admin SDK, que NO pasa
      // por estas reglas: cerrar abandonados y borrar a las 10 h sigue yendo.
      //
      // ⚠️ Todas las lecturas del documento usan .get(campo, default) y NO el
      // acceso directo: leer una clave AUSENTE de un mapa LANZA, y un error en
      // la condicion equivale a DENY. Es la misma trampa que ya se pago en el
      // `create` de abajo, detectada el 2026-07-29 con el test de SEC-C3.

      // Instante de finalizacion, con respaldo en updatedAt. El respaldo cubre
      // los partidos anteriores a v431, que nunca tuvieron sello.
      function lmAnchor() {
        return resource.data.get('finishedAt', resource.data.get('updatedAt', null));
      }
      function lmIsLive() {
        return resource.data.get('status', 'active') == 'active';
      }
      // Sin fecha utilizable NO hay ventana: si no se puede fechar el final, no
      // se puede demostrar que estemos dentro de las 2 h. Ante la duda, cerrado.
      function lmInGrace() {
        return !lmIsLive()
               && lmAnchor() != null
               && request.time < lmAnchor() + duration.value(2, 'h');
      }
      function lmFrozen() {
        return !lmIsLive() && !lmInGrace();
      }
      // En la ventana de gracia solo puede cambiar lo que hace falta para
      // registrar un EVENTO PERDIDO (perdida de bateria o cobertura). Sin este
      // `hasOnly`, la ventana permitiria reescribir el partido entero durante
      // 2 h, que es justo la falsificacion que se quiere impedir.
      //
      // v531 · Se anaden `players`, `homeTeam` y `awayTeam` a la lista, POR
      // DECISION EXPRESA DEL AUTOR (2026-08-14). Motivo: un gol o una tarjeta
      // que no se pudo anotar en su momento tiene que sumar en la ficha del
      // jugador y en el marcador, o el informe se contradice con el acumulado.
      // La ventana de gracia existe precisamente para eso.
      //
      // ⚠️ ES UNA RELAJACION REAL, no un matiz: durante esas 2 h un coach del
      // club puede corregir marcador y fichas. Lo que la acota:
      //   · sigue siendo SOLO dentro de las 2 h; pasadas, `lmFrozen()` cierra
      //     el documento entero y no hay excepcion ni para el SuperAdmin;
      //   · el resto de campos (cronometros, formacion, status, fechas) siguen
      //     FUERA de la lista, asi que no se puede reescribir el partido;
      //   · queda rastro: cada correccion anade su suceso a `events`.
      function lmOnlyEvents() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['events', 'updatedAt',
                                          'players', 'homeTeam', 'awayTeam']);
      }
      // SEC (cierre de hueco): create/update ya NO son un `if isAuth()` abierto.
      // El documento contiene PII (coachEmail, nombres/dorsales de jugadores
      // -menores-, nombre/colores de club), asi que cualquier autenticado podia
      // ANTES sobrescribir/inyectar datos en el partido en vivo de otro club sin
      // ninguna comprobacion de pertenencia. Ahora se exige que el escritor sea
      // miembro legitimo del club del partido, reutilizando EXACTAMENTE la misma
      // logica de pertenencia que ya usa `allow delete` (salvo la rama
      // `clubId == null`, deuda preexistente que NO se propaga aqui):
      //   - superadmin
      //   - club_admin / individual_admin del mismo club (por token: sameClub)
      //   - miembro cuyo users/{uid}.clubId coincide (entrenador SIN claim en el
      //     token -> userDocClubId; cubre el caso v268 del arrayUnion de eventos)
      //   - el propio creador del partido (createdBy == uid)
      //   - el entrenador cuyo email coincide con coachEmail
      //
      // CREATE: se valida contra el clubId ENTRANTE (request.resource.data). El
      // bootstrap del coach escribe primero un doc minimo `{ events: [] }` SIN
      // clubId; por eso se admite tambien al coach autor exigiendo que el
      // createdBy/coachEmail entrantes sean los del propio usuario (no puede
      // suplantar a otro entrenador ni escribir en el partido de otro club).
      // ⚠️ TODAS las lecturas del documento ENTRANTE usan .get(campo, null) y NO
      // el acceso directo .campo. NO es cosmetico: en el lenguaje de reglas,
      // leer una clave AUSENTE de un mapa LANZA, y un error en la condicion
      // equivale a DENY. El acceso directo hacia que este `create` fallara
      // SIEMPRE para el "bootstrap del coach" que el propio comentario de abajo
      // dice permitir — el doc minimo que escriben match/live/sync.js (setDoc
      // {events: []} con merge) y match/events/player-actions.js NO lleva la
      // clave clubId, asi que `request.resource.data.clubId` no era null: era un
      // ERROR. Detectado el 2026-07-29 al ejecutar por fin el test de
      // comportamiento de SEC-C3 (scripts/test_sec_c3_live_matches_rules.js),
      // que es justo la clase de fallo que una lectura estatica no ve.
      allow create: if isAuth() && (
                       isSuperAdmin() ||
                       sameClub(request.resource.data.get('clubId', null)) ||
                       userDocClubId(request.resource.data.get('clubId', null)) ||
                       // MATIZ CERRADO (createdBy/coachEmail): estas ramas SOLO
                       // autorizan cuando el doc NO lleva clubId (huerfano legacy
                       // o coach SIN club). Antes autorizaban con CUALQUIER clubId,
                       // lo que permitia a un coach del club A inyectar un partido
                       // en la lista del club B creando el doc con clubId=B y
                       // createdBy=su_propio_uid (pasaba por la rama createdBy). Con
                       // un clubId ajeno, sameClub()/userDocClubId() fallan y, al
                       // exigir clubId == null aqui, la rama queda vetada: solo el
                       // creador de un partido SIN club puede crearlo por esta via.
                       // VERIFICADO ejecutandolo: los casos f y g del test.
                       (request.resource.data.get('clubId', null) == null && (
                         (request.resource.data.get('createdBy', null) != null &&
                          request.resource.data.get('createdBy', null) == request.auth.uid) ||
                         (request.resource.data.get('coachEmail', null) != null &&
                          ('email' in request.auth.token) && request.auth.token.email != null &&
                          request.resource.data.get('coachEmail', null) == request.auth.token.email)
                       ))
                    );
      // UPDATE: se valida contra el clubId YA EXISTENTE en el documento
      // (resource.data), no contra el entrante, para evitar que un escritor
      // "reclame" el partido cambiando el clubId a uno al que pertenece.
      //
      // v434 · A la pertenencia se le suma AHORA el estado del partido. Ni
      // siquiera el SuperAdmin edita un partido cerrado: la inmutabilidad no
      // admite excepciones por rol, porque un rol con permiso para reescribir
      // el resultado es exactamente la falsificacion que se quiere impedir. El
      // SuperAdmin si conserva el BORRADO (ver `allow delete`), como valvula.
      allow update: if isAuth() && (
                       isSuperAdmin() ||
                       sameClub(resource.data.get('clubId', null)) ||
                       userDocClubId(resource.data.get('clubId', null)) ||
                       (resource.data.get('createdBy', null) != null &&
                        resource.data.get('createdBy', null) == request.auth.uid) ||
                       (resource.data.get('coachEmail', null) != null &&
                        ('email' in request.auth.token) && request.auth.token.email != null &&
                        resource.data.get('coachEmail', null) == request.auth.token.email)
                    )
                    && (
                       // Partido en curso: se escribe con normalidad. Incluye la
                       // propia transicion a 'finished', porque el estado que se
                       // mira es el ANTERIOR (resource.data), no el entrante.
                       lmIsLive() ||
                       // Ventana de 2 h: solo anadir sucesos, nada mas.
                       (lmInGrace() && lmOnlyEvents())
                    );
      // v274: Borrado ampliado para permitir limpiar partidos en vivo
      // huerfanos / descoordinados / abandonados. Puede borrar:
      //   - superadmin
      //   - cualquier club_admin/individual_admin del mismo club (token o doc)
      //   - cualquier usuario cuyo users/{uid}.clubId coincide con el clubId
      //     del partido (entrenadores sin claim de clubId en el token)
      //   - el propio entrenador que creo el partido (createdBy == uid)
      //   - el entrenador cuyo email coincide con coachEmail
      //
      // SEC-C2 (re-cerrado): se ELIMINO de nuevo la rama standalone
      // `resource.data.clubId == null`, que permitia a CUALQUIER usuario
      // autenticado borrar un partido en vivo sin clubId (PII de menores:
      // nombres, dorsales, colores). Un usuario del club B podia borrar el
      // partido huerfano de un coach del club A. El caso legitimo (el coach
      // limpia SU propio partido sin club) sigue cubierto por createdBy==uid
      // y coachEmail==token.email, que NO llevan gate de clubId. Se reintrodujo
      // en el commit c61eda0 (commit mixto que reescribio el bloque desde una
      // base obsoleta y revirtio el cierre original 1d3fe3a); aqui se re-cierra.
      //
      // v434 · CONGELADO ES TAMBIEN NO BORRABLE. Lo que no se puede editar se
      // falsificaria por omision: si un partido incomodo se puede hacer
      // desaparecer, la inmutabilidad no sirve de nada. Pasadas las 2 h solo lo
      // borra `cleanupLiveMatches` (Admin SDK, no pasa por aqui) a las 10 h.
      // El SuperAdmin conserva el borrado SIEMPRE como valvula de escape para
      // partidos de prueba, duplicados o creados por error.
      allow delete: if isAuth() && (
                       isSuperAdmin() ||
                       (
                         !lmFrozen() && (
                           sameClub(resource.data.get('clubId', null)) ||
                           userDocClubId(resource.data.get('clubId', null)) ||
                           (resource.data.get('createdBy', null) != null &&
                            resource.data.get('createdBy', null) == request.auth.uid) ||
                           (resource.data.get('coachEmail', null) != null &&
                            ('email' in request.auth.token) && request.auth.token.email != null &&
                            resource.data.get('coachEmail', null) == request.auth.token.email)
                         )
                       )
                    );
    }

    // ============================================================
    // COLECCIÓN: live_index  (v572 · P2)
    // ============================================================
    // Espejo LIGERO de live_matches: ~1.000 B con marcador, reloj, pertenencia
    // y los ultimos sucesos anunciables, para que la lista de Partidos en Vivo
    // y las alertas no tengan que descargarse el partido entero (10.625 B) de
    // CADA partido activo y en CADA latido. Lo escribe el mismo emisor
    // (js/match/live/sync.js y js/match/events/player-actions.js).
    //
    // ⚠️⚠️ NO ES UN DOCUMENTO PUBLICO POR SER PEQUENO. Lleva nombres de equipo
    // y textos de suceso que incluyen NOMBRES DE MENORES ("GOL · Fulanito"),
    // asi que su lectura se cierra EXACTAMENTE igual que la de live_matches:
    // solo usuario registrado. Aflojar esto seria reabrir P9 por la puerta de
    // atras, con los mismos datos y sin que se note.
    //
    // ⚠️ La fuente de verdad sigue siendo `live_matches`. Este documento es una
    // CACHE derivada: si se pierde o se queda atras, los lectores caen solos al
    // documento gordo (live.html:_vigilaConRespaldo). Por eso aqui no se
    // replica la ventana de gracia de 2 h con su `hasOnly` de campos — lo que
    // no se puede falsificar es el partido, y ese esta en la otra coleccion.
    // Lo que SI se replica es el candado de congelado, para que un partido
    // terminado no se pueda hacer parecer que sigue en juego en la lista.
    match /live_index/{matchId} {
      // ══════════════════════════════════════════════════════════════
      //  🔴🔴 SEC-A2 (auditoria 2026-08-25) · ACOTADO AL CLUB
      //
      //  Antes: `allow read: if isRegisteredUser()`, que es CUALQUIER usuario
      //  autenticado con isAuthorized:true — sin mirar su club. O sea que un
      //  padre de un club leia los partidos en vivo de TODOS los demas: alias
      //  de menores, dorsales, correo del entrenador, goles, tarjetas y
      //  LESIONES. El propio comentario de v-anterior enumera esa PII.
      //
      //  🔑 Y ERAN ENUMERABLES: `live_index` tenia la misma regla y ES la
      //  lista, asi que se sacaban todos los matchId de todos los clubes y con
      //  ellos se leian los documentos gordos. No habia que adivinar nada.
      //
      //  El arreglo anterior cerro "cualquiera en Internet". No cerro
      //  "cualquier usuario de OTRO club", que es el aislamiento por entidad
      //  que promete privacy.html.
      //
      //  ⚠️ LAS TRES RAMAS SON LAS TRES CONSULTAS QUE YA HACE EL VISOR desde
      //  v431/v433 (`clubId`, `createdBy`, `coachEmail`, fusionadas por id).
      //  Si se quita una, la lista de Partidos en Vivo se queda a medias: en
      //  Firestore una consulta se DENIEGA ENTERA si la regla no puede
      //  demostrar que todo lo que devuelve es legible.
      //
      //  ⚠️ SE USA `.get(campo, null)` Y NO EL ACCESO DIRECTO, y esto se
      //  MIDIO en vez de suponerlo. La primera version escribio
      //  `resource.data.clubId` creyendo que el analizador de consultas de
      //  Firestore solo reconoce el acceso directo para casar la regla con los
      //  `where`. Es FALSO: desplegadas las dos formas y lanzadas las consultas
      //  reales contra produccion con el token de un usuario normal, las seis
      //  comprobaciones dan lo mismo. Asi que manda el invariante de v438
      //  —nunca acceso directo, porque una clave ausente LANZA— que ademas
      //  fija el guard scripts/test_rules_no_direct_access.js.
      // ══════════════════════════════════════════════════════════════
      allow read: if isRegisteredUser() && (
        isSuperAdmin() ||
        sameClub(resource.data.get('clubId', null)) ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        userDocClubId(resource.data.get('clubId', null)) ||
        resource.data.get('createdBy', null) == request.auth.uid ||
        (('email' in request.auth.token) && resource.data.get('coachEmail', null) == request.auth.token.email)
      );

      // Mismo criterio de "cuando esta cerrado" que live_matches, sobre los
      // campos que el indice si copia (status/finishedAt/updatedAt).
      // ⚠️ Todas las lecturas con .get(campo, default): leer una clave AUSENTE
      // de un mapa LANZA en el lenguaje de reglas, y un error equivale a DENY.
      // Es la trampa que ya se pago en el `create` de live_matches (2026-07-29).
      function lxAnchor() {
        return resource.data.get('finishedAt', resource.data.get('updatedAt', null));
      }
      function lxIsLive() {
        return resource.data.get('status', 'active') == 'active';
      }
      function lxInGrace() {
        return !lxIsLive()
               && lxAnchor() != null
               && request.time < lxAnchor() + duration.value(2, 'h');
      }
      function lxFrozen() {
        return !lxIsLive() && !lxInGrace();
      }

      // CREATE: se valida contra el clubId ENTRANTE, igual que live_matches.
      // La rama del "bootstrap del coach" es necesaria por el mismo motivo que
      // alli: `_registerMatchEvent` puede tocar este documento con un merge que
      // solo lleva `lastEvents` + `updatedAt`, sin clubId.
      allow create: if isAuth() && (
                       isSuperAdmin() ||
                       sameClub(request.resource.data.get('clubId', null)) ||
                       userDocClubId(request.resource.data.get('clubId', null)) ||
                       (request.resource.data.get('clubId', null) == null && (
                         (request.resource.data.get('createdBy', null) != null &&
                          request.resource.data.get('createdBy', null) == request.auth.uid) ||
                         (request.resource.data.get('coachEmail', null) != null &&
                          ('email' in request.auth.token) && request.auth.token.email != null &&
                          request.resource.data.get('coachEmail', null) == request.auth.token.email)
                       ))
                    );

      // UPDATE: contra el clubId YA EXISTENTE (no el entrante), para que nadie
      // "reclame" un indice ajeno cambiandole el club. Y no se toca un indice
      // congelado: ni siquiera el SuperAdmin, misma regla que en live_matches.
      allow update: if isAuth() && (
                       isSuperAdmin() ||
                       sameClub(resource.data.get('clubId', null)) ||
                       userDocClubId(resource.data.get('clubId', null)) ||
                       (resource.data.get('createdBy', null) != null &&
                        resource.data.get('createdBy', null) == request.auth.uid) ||
                       (resource.data.get('coachEmail', null) != null &&
                        ('email' in request.auth.token) && request.auth.token.email != null &&
                        resource.data.get('coachEmail', null) == request.auth.token.email)
                    ) && !lxFrozen();

      // DELETE: mas abierto que en live_matches A PROPOSITO. Borrar un indice
      // NO destruye nada —el partido sigue entero en live_matches y el lector
      // cae solo al gordo—, asi que aqui no aplica el argumento de v434 de que
      // "lo que no se puede editar se falsificaria por omision". Se mantiene
      // acotado a quien pertenece al partido para que nadie pueda ir borrando
      // indices ajenos y devolver a todo un club al camino caro.
      allow delete: if isAuth() && (
                       isSuperAdmin() ||
                       sameClub(resource.data.get('clubId', null)) ||
                       userDocClubId(resource.data.get('clubId', null)) ||
                       (resource.data.get('createdBy', null) != null &&
                        resource.data.get('createdBy', null) == request.auth.uid) ||
                       (resource.data.get('coachEmail', null) != null &&
                        ('email' in request.auth.token) && request.auth.token.email != null &&
                        resource.data.get('coachEmail', null) == request.auth.token.email)
                    );
    }

    // ============================================================
    // COLECCIÓN: users/{uid}/cronos_data
    // ============================================================
    match /users/{userId}/cronos_data/{docId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // ══════════════════════════════════════════════════════════════════
    //  🔒 SEC-A1a (auditoria 2026-08-25) · LOS REGISTROS PRIVADOS DEL SA
    //
    //  La v628 guardo `saBajasLog` (bajas con su MOTIVO) y `saDiagnosticoLog`
    //  (cada acceso al panel de otro usuario) dentro de `users/{saUid}`. Y ese
    //  documento lo lee CUALQUIER usuario autenticado (`users` tiene
    //  `read: if isAuth()`), asi que el motivo por el que se dio de baja a una
    //  persona —"impago de cuotas"— era legible por todo el mundo. Dato
    //  personal de un tercero, y en contra de lo que promete privacy.html.
    //
    //  🔑 SE MUEVE EL DATO A UNA SUBCOLECCION CON DUENYO, en vez de esperar a
    //  poder acotar la lectura de `users` entera —que toca muchas pantallas y
    //  es un cambio de radio grande—. Misma forma que `cronos_data`, que ya
    //  resuelve exactamente este problema desde hace tiempo.
    //
    //  ⚠️ SIN ESTA REGLA la subcoleccion caeria en el catch-all del final
    //  (`allow read, write: if false`) y el registro dejaria de escribirse:
    //  el modo diagnostico se NIEGA a entrar si no puede registrar el acceso.
    // ══════════════════════════════════════════════════════════════════
    match /users/{userId}/sa_privado/{docId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // ============================================================
    // COLECCIÓN: offline_events
    // SEC-007: Validate userUid on create
    // ============================================================
    match /offline_events/{eventId} {
      allow read: if isAuth() && resource.data.get('userUid', null) == request.auth.uid;
      allow create: if isAuth() && request.resource.data.get('userUid', null) == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.get('userUid', null) == request.auth.uid;
    }

    // ============================================================
    // COLECCIÓN: config / cronos_config
    // ============================================================
    match /config/{configId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    // ══════════════════════════════════════════════════════════════════
    //  🔴 SEC-M02 (auditoria 2026-08-25) · LA REGLA DE ABAJO NO HACIA NADA
    //
    //  SEC-012 anadio `match /cronos_config/superadmins` con `read: if
    //  isSuperAdmin()` creyendo que ACOTABA el documento. No lo acotaba: en
    //  Firestore las reglas SE SUMAN, y una coincidencia mas especifica NO
    //  anula a la general. Con el comodin de aqui diciendo `read: if isAuth()`,
    //  CUALQUIER usuario autenticado seguia leyendo la lista de correos del
    //  SuperAdmin — que es la raiz de confianza de isSuperAdminEmail().
    //
    //  🔑 SE ARREGLA EN EL COMODIN, que es donde estaba el agujero: se le
    //  excluye ese id. La regla especifica de abajo pasa a ser la unica via.
    //
    //  ⚠️ NO SE PUEDE CERRAR `cronos_config` ENTERO: `cronos_config/access`
    //  guarda el codigo de acceso y lo lee app-init.js con cualquier sesion.
    //
    //  ⚠️ Y NO ROMPE AL PROPIO SUPERADMIN. `loadSuperAdminEmails` (auth.js:570)
    //  ya trata `permission-denied` como el caso normal de antes del login, y
    //  el SuperAdmin autenticado pasa por su claim. Ademas `isSuperAdminEmail()`
    //  lee el documento con `get()` DESDE LAS REGLAS, que no depende del
    //  permiso de lectura del cliente: la autorizacion del SA sigue intacta.
    // ══════════════════════════════════════════════════════════════════
    match /cronos_config/{configId} {
      allow read: if isAuth() && configId != 'superadmins';
      allow write: if isSuperAdmin();
    }

    // SEC-012: Restrict superadmins doc to superadmin-only
    match /cronos_config/superadmins {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ============================================================
    // COLECCIÓN: pseudonym_map
    // ============================================================
    match /pseudonym_map/{mapId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        sameClub(resource.data.get('clubId', null)) ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        userDocClubId(resource.data.get('clubId', null)) ||
        transitionalRead(resource.data.get('clubId', null))
      );
      allow write: if false;
    }

    // ============================================================
    // COLECCIÓN: audit_logs / error_logs
    // ============================================================
    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /error_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ============================================================
    // COLECCIÓN: notifications
    // ============================================================
    match /notifications/{notifId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        request.auth.uid == resource.data.get('userId', null) ||
        sameClubAsDoc(resource.data.get('clubId', null))
      );
      // 🔴 SEC-M01 (auditoria 2026-08-25) · antes: `if isAuth()` SIN VALIDAR
      // NADA. Cualquier usuario podia crear un aviso con `userId` y `clubId`
      // arbitrarios: avisos falsos entregados dentro de la app a quien
      // quisiera, con la marca del producto detras.
      // 🔑 Y NO ROMPE NADA: esta coleccion NO la escribe el cliente en ningun
      // sitio — medido con grep sobre todo js/, cero escrituras. La llena el
      // trigger `syncUserChanges` (functions/index.js) con el Admin SDK, que
      // NO pasa por las reglas. Se deja al SuperAdmin por si algun dia hace
      // falta una via manual, en vez de cerrarla del todo.
      allow create: if isSuperAdmin();
      allow update: if isAuth() && (
        isSuperAdmin() ||
        request.auth.uid == resource.data.get('userId', null)
      );
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // COLECCIÓN: slot_requests
    // ============================================================
    match /slot_requests/{reqId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        request.auth.uid == resource.data.get('userId', null) ||
        sameClubAsDoc(resource.data.get('clubId', null))
      );
      // 🔴 SEC-M01 (auditoria 2026-08-25) · antes: `if isAuth()`. Cualquiera
      // podia pedir plazas A NOMBRE DE OTRO CLUB, y la solicitud aparecia en
      // el panel del SuperAdmin como legitima.
      // 🔑 Ahora el clubId de la solicitud tiene que ser el SUYO. Se usan los
      // mismos predicados que el resto del fichero, asi que el flujo real
      // (js/services/user-management.js, que lee `clubs/{clubId}` antes de
      // escribir) sigue pasando: quien pide plazas pertenece a ese club.
      allow create: if isAuth() && (
        isSuperAdmin() ||
        sameClub(request.resource.data.get('clubId', null)) ||
        sameClubAsDoc(request.resource.data.get('clubId', null)) ||
        userDocClubId(request.resource.data.get('clubId', null))
      );
      allow update: if isAuth() && (
        isSuperAdmin() ||
        sameClubAsDoc(resource.data.get('clubId', null))
      );
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // COLECCIÓN: succession_requests
    // ============================================================
    match /succession_requests/{reqId} {
      allow read: if isSuperAdmin();
      // ⚠️ v438 · `'role' in request.auth.token` ANTES de leerlo. Es la UNICA
      // via de permiso de este create, asi que si el claim no esta propagado
      // —caso frecuente: token viejo, o claims recien asignados— la lectura
      // LANZA y el club_admin no puede crear su solicitud de sucesion. Aqui el
      // campo ausente si decide, al no haber ninguna otra rama que salve.
      allow create: if isAuth() &&
                       ('role' in request.auth.token) &&
                       request.auth.token.role == 'club_admin' &&
                       request.resource.data.get('outgoingAdminUid', null) == request.auth.uid;
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // COLECCIONES DE FACTURACIÓN
    // ============================================================
    match /billing_plans/{planId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    match /billing_subscriptions/{subId} {
      // ⚠️ v438 · `'clubId' in request.auth.token` antes de leerlo: sin el
      // claim propagado, esta rama LANZABA y el admin de un club no veia la
      // facturacion de SU club — la otra rama (entityId == uid) no le sirve,
      // porque su entityId es el clubId, no su uid.
      allow read: if isSuperAdmin() ||
                     (isAuth() && ('clubId' in request.auth.token) &&
                      resource.data.get('entityId', null) == request.auth.token.clubId) ||
                     (isAuth() && resource.data.get('entityId', null) == request.auth.uid);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    match /billing_invoices/{invId} {
      // ⚠️ v438 · `'clubId' in request.auth.token` antes de leerlo: sin el
      // claim propagado, esta rama LANZABA y el admin de un club no veia la
      // facturacion de SU club — la otra rama (entityId == uid) no le sirve,
      // porque su entityId es el clubId, no su uid.
      allow read: if isSuperAdmin() ||
                     (isAuth() && ('clubId' in request.auth.token) &&
                      resource.data.get('entityId', null) == request.auth.token.clubId) ||
                     (isAuth() && resource.data.get('entityId', null) == request.auth.uid);
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // COLECCIÓN: trainingPlans/{clubId}  (documento raíz)
    // SPRINT 4 — BLOQUE C: Planes de entrenamiento.
    // El documento raíz puede no existir; las semanas viven en la
    // subcolección 'weeks'. Se permite read defensivamente; el write
    // del raíz se bloquea (los datos viven en la subcolección).
    // ============================================================
    match /trainingPlans/{clubId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        sameClub(clubId)
      );
      allow write: if false;
    }

    // ============================================================
    // COLECCIÓN: trainingPlans/{clubId}/weeks/{weekKey}
    // Documentos: { ...weekData, lastModified, createdBy }
    // (NO contienen campo clubId propio → se valida contra la RUTA)
    // ============================================================
    match /trainingPlans/{clubId}/weeks/{weekKey} {
      // MIGRACIÓN (Opción A): antes el ÚNICO camino para coaches/directores
      // (roles que NO pasan sameClub(), reservado a club_admin/individual) era
      // transitionalRead(clubId) — renovable y sin verificar pertenencia. Ahora
      // se usan predicados no renovables: sameClubAsDoc (claim token.clubId) y
      // userDocClubId (users/{uid}.clubId raíz, escrito solo por Admin SDK).
      // Esto además corrige un bug latente: un director CON claims no podía
      // escribir tras expirar la ventana de 5 min (sameClub le negaba y la
      // ventana caducaba). El clubId se valida contra la RUTA del documento.
      allow read: if isAuth() && (
        isSuperAdmin() ||
        sameClub(clubId) ||
        sameClubAsDoc(clubId) ||
        userDocClubId(clubId) ||
        transitionalRead(clubId)
      );
      allow create, update: if isAuth() && (
        isSuperAdmin() ||
        sameClub(clubId) ||
        sameClubAsDoc(clubId) ||
        userDocClubId(clubId) ||
        transitionalRead(clubId)
      );
      allow delete: if isAuth() && (isSuperAdmin() || sameClub(clubId) || userDocClubId(clubId));
    }

    // ============================================================
    // COLECCIÓN: cronos_email_config
    // Configuración de contactos/envíos por entrenador. Cada doc tiene
    // coachUid como identificador del propietario. Los miembros del
    // mismo club pueden leer (para resolver destinatarios de informes).
    // ============================================================
    match /cronos_email_config/{configId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        request.auth.uid == resource.data.get('coachUid', null) ||
        userDocClubId(resource.data.get('clubId', null))
      );
      allow create: if isAuth() && (
        isSuperAdmin() ||
        sameClub(request.resource.data.get('clubId', null)) ||
        request.auth.uid == request.resource.data.get('coachUid', null) ||
        userDocClubId(request.resource.data.get('clubId', null))
      );
      allow update: if isAuth() && (
        isSuperAdmin() ||
        request.auth.uid == resource.data.get('coachUid', null) ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        userDocClubId(resource.data.get('clubId', null))
      );
      allow delete: if isSuperAdmin();
    }

    // ============================================================
    // COLECCIÓN: cronos_staff_threads
    // Hilos de comunicación entre entrenador y staff (director/coordinador).
    // Mismo esquema de acceso que cronos_messages (participants + coachUid).
    // ============================================================
    match /cronos_staff_threads/{threadId} {
      allow read: if isAuth() && (
        isSuperAdmin() ||
        request.auth.uid in resource.data.get('participants', []) ||
        request.auth.uid == resource.data.get('coachUid', null) ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        userDocClubId(resource.data.get('clubId', null))
      );
      allow create: if isAuth() && (
        isSuperAdmin() ||
        request.auth.uid in request.resource.data.get('participants', []) ||
        request.auth.uid == request.resource.data.get('coachUid', null) ||
        sameClub(request.resource.data.get('clubId', null)) ||
        userDocClubId(request.resource.data.get('clubId', null))
      );
      allow update: if isAuth() && (
        isSuperAdmin() ||
        request.auth.uid in resource.data.get('participants', []) ||
        request.auth.uid == resource.data.get('coachUid', null) ||
        sameClubAsDoc(resource.data.get('clubId', null)) ||
        userDocClubId(resource.data.get('clubId', null))
      );
      allow delete: if isAuth() &&
        (isSuperAdmin() ||
         request.auth.uid in resource.data.get('participants', []) ||
         request.auth.uid == resource.data.get('coachUid', null));
    }

    // ============================================================
    // CATCH-ALL — bloquear TODO lo no definido explícitamente
    // FIX CRÍTICO: antes era "allow read: if isAuth()"
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

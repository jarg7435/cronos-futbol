# ============================================================
# CHRONOS FÚTBOL — .gitignore (Fase 0 + Fase 1)
# ============================================================

# DEPENDENCIAS
node_modules/
**/node_modules/
functions/node_modules/

# FIREBASE
.firebase/
.firebase-*
firebase-debug.log*
firestore-debug.log*

# PII Y SECRETOS (JAMÁS EN EL REPO)
usuarios_temp.json
usuarios_temp*.json
*.BACKUP
*.REVIEW
*.bak
*.backup
serviceAccountKey.json
service-account-key.json
firebase-adminsdk-*.json
*secret*
.env
.env.*

# ARTIFACTOS DE DESARROLLO
*.diff
*.patch
test_fixes_*.js
*.log

# BUILD / DIST
dist/
build/
.cache/
.vite/

# EDITORES / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# TESTING / COBERTURA
coverage/
.nyc_output/
test-results/
junit.xml
# HERRAMIENTAS TEMPORALES DE VALIDACION DE REGLAS (no forma parte del build)
rules_test/
_*.txt
bgout.txt

# RESPALDOS DE DATOS DE PRODUCCION (JAMAS EN EL REPO)
# Volcados que se hacen ANTES de borrar algo en produccion, para que la
# operacion no sea irreversible (deleteDoc no tiene papelera). Contienen PII:
# nombres y dorsales de JUGADORES MENORES DE EDAD y correos de entrenadores.
# Se quedan en disco a proposito; subirlos a GitHub seria publicarlos.
backups/

# CAPTURAS DE PANTALLA DE LAS PRUEBAS (JAMAS EN EL REPO)
# Mismo caso que backups/, y por eso va aqui al lado. El autor deja aqui las
# capturas con las que reporta los fallos, y en ellas se leen NOMBRES Y
# DORSALES DE JUGADORES MENORES DE EDAD, correos de entrenadores y, a veces,
# la consola con identificadores de sesion. Una captura es un volcado de datos
# igual que un JSON: que sea una imagen no la hace anonima.
# Se quedan en disco; simplemente no se siguen.
CAPTURAS/

# CALENDARIOS OFICIALES EN PDF (material de trabajo, no producto)
# El autor deja aqui los PDF de la federacion con los que se calibra el lector
# del calendario de temporada. Son documentos de terceros, pesan, y no
# describen el estado del codigo: se quedan en disco y no se siguen.
CALENDARIOS/

# SCRIPTS DE INVESTIGACION/DEBUG PUNTUAL CONTRA PRODUCCION (Admin SDK)
# Nunca deben vivir en functions/ (se empaqueta en cada deploy) ni commitearse:
# acceden a produccion directamente y no forman parte del producto.
scripts/ops/

# CANAL DE TRABAJO CON LA IA (no es producto)
# Ficheros donde el autor deja los encargos y el resultado de sus pruebas.
# Cambian en cada ronda y no describen el estado del codigo, asi que en el
# historial solo anaden ruido. Se quedan en disco; simplemente no se siguen.
implementar.txt
mensajes.txt

# ============================================================
# CHRONOS FÚTBOL — .gitignore (Fase 0 + Fase 1)
# ============================================================

# DEPENDENCIAS
node_modules/
**/node_modules/
functions/node_modules/

# FIREBASE
.firebase/
.firebase-*
firebase-debug.log*
firestore-debug.log*

# PII Y SECRETOS (JAMÁS EN EL REPO)
usuarios_temp.json
usuarios_temp*.json
*.BACKUP
*.REVIEW
*.bak
*.backup
serviceAccountKey.json
service-account-key.json
firebase-adminsdk-*.json
*secret*
.env
.env.*

# ARTIFACTOS DE DESARROLLO
*.diff
*.patch
test_fixes_*.js
*.log

# BUILD / DIST
dist/
build/
.cache/
.vite/

# EDITORES / IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# TESTING / COBERTURA
coverage/
.nyc_output/
test-results/
junit.xml
# HERRAMIENTAS TEMPORALES DE VALIDACION DE REGLAS (no forma parte del build)
rules_test/
_*.txt
bgout.txt

# SCRIPTS DE INVESTIGACION/DEBUG PUNTUAL CONTRA PRODUCCION (Admin SDK)
# Nunca deben vivir en functions/ (se empaqueta en cada deploy) ni commitearse:
# acceden a produccion directamente y no forman parte del producto.
scripts/ops/

# CANAL DE TRABAJO CON LA IA (no es producto)
# Ficheros donde el autor deja los encargos y el resultado de sus pruebas.
# Cambian en cada ronda y no describen el estado del codigo, asi que en el
# historial solo anaden ruido. Se quedan en disco; simplemente no se siguen.
implementar.txt
mensajes.txt

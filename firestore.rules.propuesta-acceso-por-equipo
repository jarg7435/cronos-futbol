// QUÉ CUBRE HOY EL CLIENTE Y QUÉ NO
// ─────────────────────────────────
// El filtrado por equipo ya implementado es de PRESENTACIÓN: el entrenador
// ve en "Mis Informes" el histórico de su categoría y no el de las demás.
// Eso resuelve el uso real, pero NO es una barrera: quien use el SDK con su
// token puede leer cualquier documento de su club, igual que antes de este
// cambio. La barrera de verdad son estas reglas.
//
// ⚠️⚠️ EL OBSTÁCULO QUE HAY QUE CONOCER ANTES DE DECIDIR
// ────────────────────────────────────────────────────────
// El lenguaje de reglas NO puede recalcular la clave de equipo. cronosTeamId()
// normaliza con `normalize('NFD')` para que "Alevín" y "Alevin" sean el mismo
// equipo, y en reglas no existe esa normalización: hay `lower()`, `trim()`,
// `replace()` y `matches()`, pero nada que descomponga un acento.
//
// Consecuencia directa y muy importante:
//
//   La comparación por equipo en reglas SÓLO puede hacerse contra el campo
//   `teamId` ya escrito en el documento. El histórico anterior a este cambio
//   NO lo tiene. Si estas reglas entran tal cual, todo ese histórico deja de
//   ser legible por la rama de equipo.
//
// Por eso la rama de equipo se plantea como ADITIVA (un OR más), nunca
// sustituyendo a las de club. Endurecerla de verdad —quitar las ramas de
// club— exige antes el backfill de `teamId` que decidiste no hacer.
//
// ⚠️ Y RECUERDA: `npm run deploy:staging` NO puede probar esto. firebaseConfig
// apunta a `cronos-futbol-app`, así que cronos-futbol-test.web.app evalúa las
// reglas de PRODUCCIÓN. Estas reglas sólo se prueban de verdad con la Rules
// REST API (ver reference_rules_test_api / rules_test/) o desplegando a prod.


// ── 1. Helpers nuevos ───────────────────────────────────────────────────

// Equipo asignado al usuario, leído de SU documento. Devuelve el `teamId`
// explícito si el documento lo tiene; si no, no se intenta deducir (ver el
// obstáculo de arriba: no se puede normalizar aquí).
//
// Requiere que users/{uid} lleve `teamId`. HOY NO LO LLEVA: habría que
// escribirlo en caEditUserCategory al asignar el equipo, y en el alta.
function userTeamId() {
  return isAuth()
         && exists(/databases/$(database)/documents/users/$(request.auth.uid))
         ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('teamId', '')
         : '';
}

// ¿El usuario pertenece al equipo de este documento?
// Ambos lados tienen que tener teamId no vacío: si falta cualquiera, esta
// rama simplemente no concede (y decide otra).
function sameTeamAsDoc(docTeamId) {
  return isAuth()
         && docTeamId != null && docTeamId != ''
         && userTeamId() == docTeamId;
}

// ¿Es cuerpo técnico con vista de club entero? Director, coordinador y
// administrador NO se restringen por equipo: ven el club.
// (isTechStaffByDoc / isAdminOfClub ya existen en firestore.rules)
function veElClubEntero() {
  return isSuperAdmin() || isTechStaffByDoc() || isAdminOfClub(
    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('clubId', null)
  );
}


